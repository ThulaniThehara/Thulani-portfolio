---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../data/siteConfig';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';


// Education & Qualifications Timeline
const timeline = [
  {
    period: '2024 — Present',
    type: 'Education',
    role: '3rd Year Undergraduate — B.Sc. (Hons) in Information Technology',
    organization: 'Faculty of Information Technology, University of Moratuwa',
    description:
      'Pursuing degree studies with a strong foundation in Software Engineering, Cloud Architecture, Networking, and Distributed Systems. Maintaining a CGPA of 3.77 / 4.00.',
    tags: ['Software Engineering', 'Cloud Architecture', 'Networking', 'OOP', 'CGPA: 3.77'],
  },
  {
    period: 'Completed',
    type: 'Certification',
    role: 'Certificate Level Course in Human Resource Management',
    organization: 'International Business Studies Campus (IBS Campus)',
    description:
      'Comprehensive coursework covering core human resource management principles, organizational behavior, professional communication, and leadership practices.',
    tags: ['Human Resource Management', 'Organizational Behavior', 'Leadership'],
  },
];
---

<BaseLayout
  title={`About | ${siteConfig.author}`}
  description="About Thulani — software engineer working across full-stack web, cloud, AI, and IoT systems."
>
  <div class="max-w-4xl mx-auto py-12 px-4 sm:px-6 lg:px-8 space-y-16">
    
    <!-- 1. Introduction -->
    <section class="space-y-6">
      <div class="space-y-3">
        <span class="text-xs font-semibold uppercase tracking-wider text-[var(--brand-deep-teal)]">About</span>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-[var(--text-primary)] leading-[1.1]">
          Hi, I'm {siteConfig.author}
        </h1>
      </div>

      <div class="space-y-4 text-base text-[var(--text-secondary)] leading-relaxed max-w-2xl">
        <p>
          I’m a 3rd Year IT Undergraduate at the University of Moratuwa with a passion for software development and emerging technologies.
        </p>
        <p>
         I enjoy building practical, user-focused solutions while exploring full-stack development, cloud computing, and AI. I’m always eager to learn, experiment, and turn ideas into meaningful digital experiences.
        </p>
      </div>

      <div class="flex flex-wrap gap-4">
        <Button href="/work" variant="primary" size="md" class="group">
          View My Work
          <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </Button>
        <Button href="/contact" variant="outline" size="md">
          Get in Touch
        </Button>
      </div>
    </section>

    <!-- 2. Education & Qualifications Timeline -->
    <section class="space-y-6">
      <div class="space-y-1">
        <span class="text-xs font-semibold uppercase tracking-wider text-[var(--brand-deep-teal)]">Education & Qualifications</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[var(--text-primary)]">
          Background
        </h2>
      </div>

      <div class="space-y-4">
        {timeline.map((item) => (
          <div class="rounded-2xl bg-white border border-[var(--border-subtle)] p-6 space-y-3 shadow-2xs hover:border-[var(--brand-soft-teal)] transition-colors">
            <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-2">
              <div class="space-y-0.5">
                <h3 class="text-base sm:text-lg font-bold text-[var(--text-primary)]">{item.role}</h3>
                <div class="text-sm font-semibold text-[var(--brand-deep-teal)]">{item.organization}</div>
              </div>
              <Badge variant={item.type === 'Education' ? 'soft-teal' : 'peach'} size="sm">
                {item.period}
              </Badge>
            </div>

            <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
              {item.description}
            </p>

            <div class="flex flex-wrap gap-1.5 pt-2 border-t border-[var(--border-subtle)]">
              {item.tags.map((tag) => (
                <Badge variant="subtle" size="sm">
                  {tag}
                </Badge>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 4. Contact CTA -->
    <section class="rounded-2xl bg-[var(--brand-deep-teal)] text-white p-8 sm:p-12 text-center space-y-5">
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
        Let's build something together
      </h2>
      <p class="text-sm text-[var(--brand-ice-white)]/85 max-w-lg mx-auto">
        I'm open to full-stack engineering roles, cloud architecture projects, and IoT hardware collaborations.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <Button href="/contact" variant="accent" size="lg">
          Get in Touch
        </Button>
        <Button
          href={`mailto:${siteConfig.social.email}`}
          variant="outline"
          size="lg"
          class="!border-white !text-white hover:!bg-white/10"
        >
          Send an Email
        </Button>
      </div>
    </section>

  </div>
</BaseLayout>
