---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../data/siteConfig';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';


// Timeline
const timeline = [
  {
    period: '2023 — Present',
    type: 'Engineering',
    role: 'Software & Systems Engineer',
    organization: 'Independent Projects & Contract Development',
    description:
      'Building serverless cloud platforms, IoT telemetry solutions, and AI applications. Key projects include the Enlear HRMS (AWS AppSync, DynamoDB, Lambda) and the Smart Shooting Gallery IoT hardware rig.',
    tags: ['AWS', 'React', 'TypeScript', 'ESP32', 'DynamoDB'],
  },
  {
    period: '2021 — 2024',
    type: 'Education',
    role: 'B.Sc. in Software Engineering',
    organization: 'University Engineering Curriculum',
    description:
      'Foundation in Data Structures, Algorithms, Distributed Computing, Database Systems, and Software Architecture.',
    tags: ['Algorithms', 'System Design', 'Databases', 'Networking'],
  },
  {
    period: '2022 — 2023',
    type: 'Engineering',
    role: 'Full-Stack Developer',
    organization: 'Web Platforms & E-Commerce',
    description:
      'Built responsive full-stack applications including Slice of Heaven e-commerce platform with PostgreSQL, Prisma, and Stripe integration.',
    tags: ['React', 'Node.js', 'PostgreSQL', 'Prisma', 'Stripe'],
  },
];
---

<BaseLayout
  title={`About | ${siteConfig.author}`}
  description="About Thulani — software engineer working across full-stack web, cloud, AI, and IoT systems."
>
  <div class="max-w-4xl mx-auto py-12 px-4 sm:px-6 lg:px-8 space-y-16">
    
    <!-- 1. Introduction -->
    <section class="space-y-6">
      <div class="space-y-3">
        <span class="text-xs font-semibold uppercase tracking-wider text-[var(--brand-deep-teal)]">About</span>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-[var(--text-primary)] leading-[1.1]">
          Hi, I'm {siteConfig.author}
        </h1>
      </div>

      <div class="space-y-4 text-base text-[var(--text-secondary)] leading-relaxed max-w-2xl">
        <p>
          I’m a 3rd Year IT Undergraduate at the University of Moratuwa with a passion for software development and emerging technologies.
        </p>
        <p>
         I enjoy building practical, user-focused solutions while exploring full-stack development, cloud computing, and AI. I’m always eager to learn, experiment, and turn ideas into meaningful digital experiences.
        </p>
      </div>

      <div class="flex flex-wrap gap-4">
        <Button href="/work" variant="primary" size="md" class="group">
          View My Work
          <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </Button>
        <Button href="/contact" variant="outline" size="md">
          Get in Touch
        </Button>
      </div>
    </section>



    <!-- 3. Experience & Education Timeline -->
    <section class="space-y-6">
      <div class="space-y-1">
        <span class="text-xs font-semibold uppercase tracking-wider text-[var(--brand-deep-teal)]">Experience</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[var(--text-primary)]">
          Background
        </h2>
      </div>

      <div class="space-y-4">
        {timeline.map((item) => (
          <div class="rounded-2xl bg-white border border-[var(--border-subtle)] p-5 space-y-3">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
              <div>
                <h3 class="text-base font-bold text-[var(--text-primary)]">{item.role}</h3>
                <div class="text-xs font-semibold text-[var(--brand-deep-teal)]">{item.organization}</div>
              </div>
              <Badge variant={item.type === 'Engineering' ? 'soft-teal' : 'subtle'} size="sm">
                {item.period}
              </Badge>
            </div>

            <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
              {item.description}
            </p>

            <div class="flex flex-wrap gap-1.5 pt-2 border-t border-[var(--border-subtle)]">
              {item.tags.map((tag) => (
                <Badge variant="subtle" size="sm">
                  {tag}
                </Badge>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 4. Contact CTA -->
    <section class="rounded-2xl bg-[var(--brand-deep-teal)] text-white p-8 sm:p-12 text-center space-y-5">
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
        Let's build something together
      </h2>
      <p class="text-sm text-[var(--brand-ice-white)]/85 max-w-lg mx-auto">
        I'm open to full-stack engineering roles, cloud architecture projects, and IoT hardware collaborations.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <Button href="/contact" variant="accent" size="lg">
          Get in Touch
        </Button>
        <Button
          href={`mailto:${siteConfig.social.email}`}
          variant="outline"
          size="lg"
          class="!border-white !text-white hover:!bg-white/10"
        >
          Send an Email
        </Button>
      </div>
    </section>

  </div>
</BaseLayout>
