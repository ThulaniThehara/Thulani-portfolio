---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../data/siteConfig';
---

<BaseLayout title={`Lab & Experiments | ${siteConfig.author}`}>
  <div class="max-w-4xl mx-auto py-12 space-y-10">
    <header class="space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#006D77]/10 text-[#006D77] text-xs font-semibold uppercase tracking-wider">
        <span>R&D Sandbox</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-[#102A30]">Lab & Technical Experiments</h1>
      <p class="text-lg text-[#547A85] leading-relaxed max-w-2xl">
        A dedicated space for technical explorations, hardware telemetry prototypes, AI agent workflows, and graphics/shader experiments.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-white p-6 rounded-2xl border border-[#D8EAEF] space-y-3">
        <div class="w-10 h-10 rounded-xl bg-[#83C5BE]/20 flex items-center justify-center text-[#006D77] font-mono text-sm font-bold">
          01
        </div>
        <h2 class="text-xl font-bold text-[#102A30]">Real-Time IoT Telemetry Sandbox</h2>
        <p class="text-sm text-[#547A85]">
          Testing low-latency MQTT message queues with ESP32 microcontrollers and browser-based WebSockets.
        </p>
      </div>

      <div class="bg-white p-6 rounded-2xl border border-[#D8EAEF] space-y-3">
        <div class="w-10 h-10 rounded-xl bg-[#83C5BE]/20 flex items-center justify-center text-[#006D77] font-mono text-sm font-bold">
          02
        </div>
        <h2 class="text-xl font-bold text-[#102A30]">Autonomous Agent Workflows</h2>
        <p class="text-sm text-[#547A85]">
          Experimenting with LLM tool-calling loops, context management, and structured generation.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
