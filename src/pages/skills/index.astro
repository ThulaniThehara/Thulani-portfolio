---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../data/siteConfig';
import TechnicalInterests from '../../components/sections/TechnicalInterests.astro';
import Button from '../../components/ui/Button.astro';
---

<BaseLayout
  title={`Technical Skills & Arsenal | ${siteConfig.author}`}
  description="Explore the technical capabilities, languages, frameworks, cloud primitives, and embedded hardware tools used by Thulani."
>
  <div class="max-w-6xl mx-auto py-12 px-4 sm:px-6 lg:px-8 space-y-12">
    <!-- Header -->
    <header class="space-y-4 max-w-3xl animate-fade-in-up">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--bg-surface-teal-subtle)] text-[var(--brand-deep-teal)] text-xs font-semibold uppercase tracking-wider">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--brand-deep-teal)] animate-pulse"></span>
        <span>Capabilities Matrix</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-[var(--text-primary)] leading-[1.1]">
        Technical Skills & Architecture Arsenal
      </h1>
      <p class="text-lg text-[var(--text-muted)] leading-relaxed">
        A breakdown of the technologies I use across full-stack development, serverless cloud backends, intelligent AI applications, and IoT embedded hardware.
      </p>
    </header>

    <!-- Animated Cards Section -->
    <div class="rounded-3xl border border-[var(--border-subtle)] bg-white overflow-hidden shadow-xs">
      <TechnicalInterests />
    </div>

    <!-- Additional Architecture Pillars CTA -->
    <div class="rounded-3xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] p-8 sm:p-12 text-center space-y-4">
      <h2 class="text-2xl font-bold text-[var(--text-primary)]">
        Want to see how these skills apply to real systems?
      </h2>
      <p class="text-sm text-[var(--text-muted)] max-w-lg mx-auto">
        Read detailed technical case studies explaining architecture decisions, DynamoDB single-table schemas, and ESP32 hardware builds.
      </p>
      <div class="pt-2 flex justify-center gap-4">
        <Button href="/work" variant="primary" size="md">
          Explore Case Studies
        </Button>
        <Button href="/contact" variant="outline" size="md">
          Get in Touch
        </Button>
      </div>
    </div>
  </div>
</BaseLayout>
