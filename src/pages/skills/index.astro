---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Lab & Experiments | Portfolio">
  <div class="max-w-3xl mx-auto py-8 space-y-8">
    <header class="space-y-4">
      <h1 class="text-4xl font-extrabold tracking-tight">Lab & Experiments</h1>
      <p class="text-lg text-gray-600 dark:text-gray-300">
        R&D playground for 3D shaders, WebGL experiments, AI agent prototypes, and hardware telemetry proofs-of-concept.
      </p>
    </header>

    <div class="border border-dashed border-gray-300 dark:border-gray-700 rounded-xl p-8 text-center text-gray-500">
      <p>Lab prototypes and experimental sandbox modules will be integrated in subsequent stages.</p>
    </div>
  </div>
</BaseLayout>
