---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import ExploringRow from '../../components/exploring/ExploringRow.astro';
import { exploringTopics } from '../../data/exploringTopics';
import { siteConfig } from '../../data/siteConfig';
---

<BaseLayout
  title={`Currently Exploring | ${siteConfig.author}`}
  description="The technologies and domains I'm actively learning — cloud and serverless, generative AI, cybersecurity, networking, cross-platform mobile, and DevOps."
>
  <div class="max-w-5xl mx-auto py-12 px-4 sm:px-6 lg:px-8 space-y-14">
    <!-- Header -->
    <header class="max-w-2xl space-y-5 animate-fade-in-up">
      <div>
        <Badge variant="soft-teal" size="md" dot>
          Actively Learning
        </Badge>
      </div>

      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-[var(--text-primary)] leading-[1.1]">
        Currently Exploring
      </h1>

      <p class="text-lg text-[var(--text-secondary)] leading-relaxed">
        Areas I'm actively deepening beyond the work already shipped — the directions my learning is pointed right now.
      </p>

      <!-- Count strip -->
      <div class="flex items-center gap-5 pt-3 border-t border-[var(--border-subtle)]">
        <div>
          <div class="text-3xl font-extrabold text-[var(--brand-deep-teal)] leading-none tabular-nums">
            {String(exploringTopics.length).padStart(2, '0')}   <br/> <br/>
          </div>
          <div class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-muted)] mt-1.5">
            
          </div>
        </div>
        <div class="h-10 w-px bg-[var(--border-subtle)]"></div>
        <p class="text-sm text-[var(--text-muted)] leading-relaxed max-w-xs">
        Each of these feeds directly into what I build next. <br/> <br/>
        </p>
      </div>
    </header>

    <!-- Topic Timeline -->
    <div class="relative space-y-10 sm:space-y-12">
      <!-- Vertical spine: left rail on mobile, centered on desktop -->
      <span
        class="absolute top-2 bottom-2 w-[2px] left-6 lg:left-1/2 lg:-translate-x-1/2 rounded-full bg-gradient-to-b from-[var(--brand-deep-teal)] via-[var(--brand-soft-teal)] to-[var(--brand-coral)] opacity-40"
        aria-hidden="true"
      ></span>

      {exploringTopics.map((topic, index) => (
        <ExploringRow topic={topic} index={index} />
      ))}
    </div>

    <!-- Closing note -->
    <div class="p-7 sm:p-9 rounded-2xl bg-gradient-to-br from-[var(--bg-surface-teal-subtle)] via-[var(--bg-surface)] to-[var(--bg-surface)] border border-[var(--border-subtle)] space-y-3">
      <div class="flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-[var(--brand-deep-teal)]">
        <span class="w-2 h-2 rounded-full bg-[var(--brand-deep-teal)] animate-pulse"></span>
        <span>Always Open</span>
      </div>
      <p class="text-[15px] text-[var(--text-secondary)] leading-[1.7] max-w-2xl">
        If you're working on something in any of these areas — or think I should be looking at something that isn't on this list — I'd genuinely like to hear about it.
      </p>
      <div class="pt-2 flex flex-wrap gap-3">
        <Button href="/contact" variant="primary" size="md">
          Start a Conversation
        </Button>
        <Button href="/work" variant="outline" size="md">
          See What I've Built
        </Button>
      </div>
    </div>
  </div>
</BaseLayout>
