---
import Button from '../ui/Button.astro';
import LiquidDrops from '../background/LiquidDrops.astro';
import { siteConfig } from '../../data/siteConfig';
import { getUrl } from '../../utils/url';
---

<section class="relative py-16 sm:py-24 lg:py-32 border-b border-[var(--border-subtle)] overflow-hidden">
  <!-- MATCHING AMBIENT BACKGROUND ANIMATION (Dhananjaya C Style) -->
  <!-- 1. Minimal Radial Grid Texture -->
  <div class="absolute inset-0 pointer-events-none opacity-25 bg-[radial-gradient(#8FD6E9_1px,transparent_1px)] [background-size:28px_28px]"></div>

  <!-- 2. Floating Ambient Glow Blobs -->
  <div class="absolute top-1/4 -left-20 w-80 h-80 rounded-full bg-gradient-to-tr from-[#8FD6E9]/25 to-[#03045A]/15 blur-3xl animate-blob-slow-1 pointer-events-none"></div>
  <div class="absolute bottom-10 right-10 w-96 h-96 rounded-full bg-gradient-to-br from-[#0090BF]/20 via-[#8FD6E9]/20 to-transparent blur-3xl animate-blob-slow-2 pointer-events-none"></div>

  <!-- 3. Floating Bokeh Dust (canvas; pass videoSrc to swap in a real clip) -->
  <LiquidDrops intensity={1} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 lg:gap-14 items-center">
      <!-- LEFT COLUMN: Intro & Text Content -->
      <div class="md:col-span-7 space-y-6">
        <!-- Status Badge -->
        <div class="animate-fade-in-up">
          <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[var(--bg-surface-teal-subtle)] text-[var(--brand-deep-teal)] text-xs font-semibold shadow-2xs border border-[var(--border-subtle)]">
            <span class="w-2 h-2 rounded-full bg-[var(--brand-coral)] animate-pulse"></span>
            Available for opportunities
          </span>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-[var(--text-primary)] leading-[1.1] animate-fade-in-up delay-100">
          Hi, I'm <span class="text-[var(--brand-deep-teal)]">{siteConfig.author}</span>
        </h1>

        <!-- Short Description -->
        <p class="text-lg sm:text-xl text-[var(--text-muted)] leading-relaxed animate-fade-in-up delay-150">
          3rd Year IT Undergraduate & Full-Stack Developer <br/>

          <br/> Building practical software solutions by blending technical expertise, cloud technologies, and creative problem-solving.

        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap items-center gap-4 pt-2 animate-fade-in-up delay-200">
          <Button href="/work" variant="primary" size="lg" class="group">
            View My Work
            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </Button>
          <Button href="/contact" variant="outline" size="lg">
            Get in Touch
          </Button>
        </div>

        <!-- EMPHASIZED "FIND ME ON" SOCIAL AREA -->
        <div class="pt-6 border-t border-[var(--border-subtle)] animate-fade-in-up delay-300 space-y-3">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[var(--brand-deep-teal)]"></span>
            <span class="text-xs font-bold uppercase tracking-wider text-[var(--brand-deep-teal)]">
              Find Me On
            </span>
          </div>

          <div class="flex flex-wrap gap-2.5">
            <!-- GitHub -->
            <a
              href={siteConfig.social.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white border border-[var(--border-medium)] text-[var(--text-primary)] hover:border-[var(--brand-deep-teal)] hover:bg-[var(--bg-page)] hover:-translate-y-0.5 shadow-2xs transition-all font-medium text-xs group"
              aria-label="GitHub Profile"
            >
              <svg class="w-4 h-4 text-[var(--brand-deep-teal)] group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
              <span>GitHub</span>
            </a>

            <!-- LinkedIn -->
            <a
              href={siteConfig.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white border border-[var(--border-medium)] text-[var(--text-primary)] hover:border-[var(--brand-deep-teal)] hover:bg-[var(--bg-page)] hover:-translate-y-0.5 shadow-2xs transition-all font-medium text-xs group"
              aria-label="LinkedIn Profile"
            >
              <svg class="w-4 h-4 text-[var(--brand-deep-teal)] group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
              </svg>
              <span>LinkedIn</span>
            </a>

            <!-- Medium -->
            <a
              href={siteConfig.social.medium}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white border border-[var(--border-medium)] text-[var(--text-primary)] hover:border-[var(--brand-deep-teal)] hover:bg-[var(--bg-page)] hover:-translate-y-0.5 shadow-2xs transition-all font-medium text-xs group"
              aria-label="Medium Profile"
            >
              <svg class="w-4 h-4 text-[var(--brand-deep-teal)] group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
                <path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42c1.87 0 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z" />
              </svg>
              <span>Medium</span>
            </a>

            <!-- Direct Email (Opens Gmail Web Compose) -->
            <a
              href={`https://mail.google.com/mail/?view=cm&fs=1&to=${siteConfig.social.email}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-[var(--bg-surface-teal-subtle)] border border-[var(--border-medium)] text-[var(--brand-deep-teal)] hover:border-[var(--brand-deep-teal)] hover:bg-[var(--brand-soft-teal-light)] hover:-translate-y-0.5 shadow-2xs transition-all font-bold text-xs group"
              aria-label="Send Email in Gmail"
            >
              <svg class="w-4 h-4 text-[var(--brand-deep-teal)] group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span>{siteConfig.social.email}</span>
            </a>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: Circular Profile Photo Frame (Dhananjaya C Style) -->
      <div class="md:col-span-5 flex justify-center md:justify-end items-center animate-fade-in-scale delay-200">
        <div class="relative group">
          <!-- Ambient Glow Aura -->
          <div class="absolute -inset-4 bg-gradient-to-r from-[var(--brand-deep-teal)] via-[var(--brand-soft-teal)] to-[var(--brand-coral)] rounded-full opacity-25 blur-2xl group-hover:opacity-45 transition-opacity duration-500"></div>

          <!-- Decorative Outer Rotating Rings -->
          <div class="absolute -top-5 -right-5 w-24 h-24 border-2 border-[var(--brand-soft-teal)]/40 rounded-full animate-border-rotate pointer-events-none"></div>
          <div class="absolute -bottom-5 -left-5 w-32 h-32 border-2 border-[var(--brand-coral)]/30 rounded-full animate-border-rotate-rev pointer-events-none"></div>

          <!-- Main Rotating Circular Border Frame -->
          <div class="relative w-64 h-64 sm:w-72 sm:h-72 lg:w-80 lg:h-80">
            <!-- Animated Gradient Ring -->
            <div class="absolute inset-0 rounded-full animate-border-rotate p-[3px] bg-gradient-to-r from-[var(--brand-deep-teal)] via-[var(--brand-soft-teal)] to-[var(--brand-coral)] shadow-card">
              <div class="w-full h-full rounded-full bg-white"></div>
            </div>

            <!-- Profile Photo Container -->
            <div class="absolute inset-2 rounded-full overflow-hidden border-2 border-[var(--border-subtle)] bg-[var(--brand-ice-white)] shadow-inner">
              <img
                src={getUrl('/images/profile/profile.jpg')}
                alt={siteConfig.author}
                class="w-full h-full object-cover object-top hover:scale-108 transition-transform duration-700"
                loading="eager"
              />
              <!-- Subtle Hover Overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-[var(--brand-deep-teal)]/30 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            </div>
          </div>

          <!-- Floating Status Badge -->
          <div class="absolute -bottom-4 left-1/2 -translate-x-1/2 px-4 py-2 bg-white/95 border border-[var(--border-subtle)] rounded-full shadow-lg whitespace-nowrap backdrop-blur-sm">
            <p class="text-xs font-bold text-[var(--brand-deep-teal)] flex items-center gap-2">
              <span class="w-2 h-2 bg-[var(--brand-coral)] rounded-full animate-pulse"></span>
              Open to work
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
