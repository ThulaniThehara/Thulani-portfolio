---
import Button from '../ui/Button.astro';
import { siteConfig } from '../../data/siteConfig';
---

<section class="relative py-20 sm:py-28 lg:py-36 border-b border-[var(--border-subtle)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="max-w-3xl space-y-6">
      <!-- Status Badge -->
      <div class="animate-fade-in-up">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--bg-surface-teal-subtle)] text-[var(--brand-deep-teal)] text-xs font-semibold">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--brand-deep-teal)] animate-pulse"></span>
          Available for opportunities
        </span>
      </div>

      <!-- Headline -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-[var(--text-primary)] leading-[1.1] animate-fade-in-up delay-100">
        Hi, I'm <span class="text-[var(--brand-deep-teal)]">{siteConfig.author}</span>
      </h1>

      <!-- Short Description -->
      <p class="text-lg sm:text-xl text-[var(--text-muted)] leading-relaxed animate-fade-in-up delay-150">
        I build full-stack applications, serverless cloud systems, AI workflows, and IoT hardware solutions.
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap items-center gap-4 pt-2 animate-fade-in-up delay-200">
        <Button href="/work" variant="primary" size="lg" class="group">
          View My Work
          <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </Button>
        <Button href="/contact" variant="outline" size="lg">
          Get in Touch
        </Button>
      </div>

      <!-- Social Links -->
      <div class="flex items-center gap-4 pt-4 animate-fade-in-up delay-300">
        <span class="text-xs text-[var(--text-muted)]">Find me on</span>
        <div class="h-px w-6 bg-[var(--border-subtle)]"></div>
        <div class="flex gap-2">
          <a
            href={siteConfig.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded-lg bg-white border border-[var(--border-subtle)] text-[var(--text-muted)] hover:text-[var(--brand-deep-teal)] hover:border-[var(--brand-soft-teal)] transition-all"
            aria-label="GitHub"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
          </a>
          <a
            href={siteConfig.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded-lg bg-white border border-[var(--border-subtle)] text-[var(--text-muted)] hover:text-[var(--brand-deep-teal)] hover:border-[var(--brand-soft-teal)] transition-all"
            aria-label="LinkedIn"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
            </svg>
          </a>
          <a
            href={`mailto:${siteConfig.social.email}`}
            class="p-2 rounded-lg bg-white border border-[var(--border-subtle)] text-[var(--text-muted)] hover:text-[var(--brand-deep-teal)] hover:border-[var(--brand-soft-teal)] transition-all"
            aria-label="Email"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
