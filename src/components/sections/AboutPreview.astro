---
import Button from '../ui/Button.astro';
import { siteConfig } from '../../data/siteConfig';
---

<section class="py-16 sm:py-24 relative overflow-hidden" style="perspective: 1200px;">
  <!-- Subtle Ambient Glow in background -->
  <div class="absolute top-1/2 -right-24 w-96 h-96 rounded-full bg-[var(--brand-soft-teal)]/10 blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      
      <!-- LEFT COLUMN: Narrative & CTAs -->
      <div class="lg:col-span-7 space-y-6 reveal-on-scroll approach-3d">
        <!-- Section Badge -->
        <div>
          <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[var(--bg-surface-teal-subtle)] text-[var(--brand-deep-teal)] text-xs font-semibold uppercase tracking-wider border border-[var(--border-subtle)]">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--brand-coral)] animate-pulse"></span>
            About Me
          </span>
        </div>

        <!-- Headline -->
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text-primary)] leading-snug">
          Passionate about building innovative software solutions through Technology, Creativity, and Continuous Learning.
        </h2>

        <!-- Description -->
        <p class="text-base sm:text-lg text-[var(--text-muted)] leading-relaxed">
          I am an IT undergraduate passionate about engineering complete digital solutions. From robust full-stack platforms and serverless cloud architectures to applied AI workflows and IoT hardware, I turn complex problems into clean, high-performance systems.
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <Button href="/about" variant="primary" size="md" class="group">
            Read Full Profile
            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform duration-150" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </Button>
          <Button href="/work" variant="outline" size="md">
            Explore Projects
          </Button>
        </div>
      </div>

      <!-- RIGHT COLUMN: Academic Card (Referencing Image 4) -->
      <div class="lg:col-span-5">
        <div class="reveal-on-scroll approach-3d relative rounded-3xl bg-white border border-[var(--border-subtle)] p-6 sm:p-8 shadow-card hover:shadow-card-hover transition-all duration-300 space-y-4">
          
          <!-- Top Badge -->
          <div>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-[#DFF3F8] text-[#017286] border border-[var(--border-peach)]">
              Academic
            </span>
          </div>

          <!-- University Name + 3rd Year right-aligned -->
          <div class="flex items-start justify-between gap-4 pt-1">
            <h3 class="text-xl sm:text-2xl font-extrabold text-[var(--text-primary)] tracking-tight leading-snug">
              University of Moratuwa, Sri Lanka
            </h3>
            <span class="text-sm font-bold text-[#03045A] bg-[#C3E7EF] px-3 py-1 rounded-lg shrink-0 font-mono">
              3rd Year
            </span>
          </div>

          <!-- Degree Name -->
          <p class="text-sm font-semibold text-[var(--text-secondary)]">
            B.Sc. (Hons) Information Technology
          </p>

          <!-- Degree focus description -->
          <p class="text-sm text-[var(--text-muted)] leading-relaxed pt-1">
            Undergraduate degree focused on Software Engineering, Cloud Architecture, Artificial Intelligence, and Distributed Systems.
          </p>

          <!-- CGPA Highlight -->
          <div class="pt-3 border-t border-[var(--border-subtle)] flex items-center justify-between">
            <div class="text-base font-extrabold text-[#03045A] font-mono tracking-tight flex items-center gap-1.5">
              <span>CGPA: 3.77 / 4.00</span>
            </div>
    
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
