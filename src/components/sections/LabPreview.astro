---
import Button from '../ui/Button.astro';

const experiments = [
  {
    tag: 'Hardware & WebSockets',
    title: 'ESP32 Real-Time Sensor Telemetry',
    summary: 'Bi-directional sensor messaging with sub-50ms latency across cloud edge brokers.',
  },
  {
    tag: 'LLM Agents & Tools',
    title: 'Autonomous System Tool-Calling',
    summary: 'Explorations in constrained JSON output schemas and dynamic agent memory graphs.',
  },
  {
    tag: 'Graphics & Shaders',
    title: 'WebGL & Three.js Viewports',
    summary: 'Interactive 3D geometry renders and custom GPU fragment shaders.',
  },
];
---

<section class="py-16 sm:py-24 max-w-6xl mx-auto px-4 sm:px-6 reveal-on-scroll">
  <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-[#1F2937] via-[#020341] to-[#03045A] text-white p-8 sm:p-12 lg:p-16 shadow-md hover:shadow-lg transition-shadow">
    <!-- Subtle Background Graphic Grid -->
    <div class="absolute inset-0 opacity-10 pointer-events-none bg-[radial-gradient(#8FD6E9_1px,transparent_1px)] [background-size:16px_16px]"></div>

    <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <div class="lg:col-span-6 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur-xs text-[#8FD6E9] text-xs font-semibold uppercase tracking-wider border border-white/10">
          <span class="w-2 h-2 rounded-full bg-[#8FD6E9] animate-ping"></span>
          <span>Experimental Sandbox</span>
        </div>

        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
          The Lab & R&D Explorations
        </h2>

        <p class="text-base text-[#F5F9FB]/85 leading-relaxed">
          Not all code belongs in a formal production release. The Lab is where I stress-test early prototypes, explore bleeding-edge frameworks, build hardware hacks, and document technical experiments.
        </p>

        <div class="pt-2">
          <Button href="/lab" variant="accent" size="md" class="group">
            Explore The Lab
            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform duration-150" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </Button>
        </div>
      </div>

      <!-- Right list of experiment highlights with hover lift -->
      <div class="lg:col-span-6 space-y-3 font-sans">
        {experiments.map((exp, idx) => (
          <div class="p-4 rounded-xl bg-white/10 backdrop-blur-sm border border-white/10 hover:bg-white/15 hover:-translate-y-0.5 transition-all duration-200">
            <div class="flex items-center justify-between text-xs text-[#8FD6E9] font-mono mb-1">
              <span>{exp.tag}</span>
              <span>0{idx + 1}</span>
            </div>
            <h3 class="text-base font-bold text-white mb-1">{exp.title}</h3>
            <p class="text-xs text-[#F5F9FB]/80">{exp.summary}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
