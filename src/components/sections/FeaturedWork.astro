---
import { getFeaturedProjects } from '../../utils/projects';
import ProjectCard from '../projects/ProjectCard.astro';
import Button from '../ui/Button.astro';

const featuredProjects = await getFeaturedProjects();
---

<section class="py-16 sm:py-24 max-w-6xl mx-auto px-4 sm:px-6 reveal-on-scroll">
  <!-- Section Header -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
    <div class="space-y-3 max-w-xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--bg-surface-teal-subtle)] text-[var(--brand-deep-teal)] text-xs font-semibold uppercase tracking-wider">
        <span>Portfolio Highlights</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[var(--text-primary)]">
        Selected Work & Systems
      </h2>
      <p class="text-base text-[var(--text-muted)] leading-relaxed">
        Production systems, IoT hardware implementations, and intelligent applications built with end-to-end engineering rigor.
      </p>
    </div>

    <div>
      <Button href="/work" variant="outline" size="sm" class="group">
        View All Projects
        <svg class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform duration-150" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </Button>
    </div>
  </div>

  <!-- Projects Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-6 sm:gap-8">
    {featuredProjects.map((project) => (
      <ProjectCard
        id={project.id}
        title={project.data.title}
        description={project.data.description}
        category={project.data.category}
        tags={project.data.technologies || project.data.tags || []}
        publishDate={project.data.publishDate || `${project.data.year}-01-01`}
      />
    ))}
  </div>
</section>
