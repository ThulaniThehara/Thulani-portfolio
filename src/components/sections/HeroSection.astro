---
import Button from '../ui/Button.astro';
import { siteConfig } from '../../data/siteConfig';
---

<section class="py-16 sm:py-24 text-center sm:text-left">
  <div class="max-w-3xl space-y-6">
    <div class="inline-block px-3 py-1 text-xs font-semibold uppercase tracking-wider text-blue-600 bg-blue-50 dark:bg-blue-950 dark:text-blue-400 rounded-full">
      Software Engineer & Architect
    </div>
    <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight">
      Hi, I'm <span class="text-blue-600">{siteConfig.author}</span>.
    </h1>
    <p class="text-lg text-gray-600 dark:text-gray-300">
      Specializing in full-stack web applications, cloud/serverless architecture, artificial intelligence, and IoT hardware systems.
    </p>
    <div class="flex flex-wrap gap-4 justify-center sm:justify-start pt-2">
      <Button href="/work" variant="primary">View Work</Button>
      <Button href="/contact" variant="outline">Get in Touch</Button>
    </div>
  </div>
</section>
