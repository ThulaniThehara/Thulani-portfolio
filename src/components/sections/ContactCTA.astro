---
import Button from '../ui/Button.astro';
import { siteConfig } from '../../data/siteConfig';
---

<section class="py-16 sm:py-24 max-w-6xl mx-auto px-4 sm:px-6">
  <div class="bg-gradient-to-b from-white to-[#EDF6F9] rounded-3xl border border-[#D8EAEF] p-8 sm:p-12 lg:p-16 text-center space-y-8 shadow-xs">
    <div class="max-w-2xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#006D77]/10 text-[#006D77] text-xs font-semibold uppercase tracking-wider">
        <span>Let's Connect</span>
      </div>

      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-[#102A30]">
        Have an idea worth building?
      </h2>

      <p class="text-base sm:text-lg text-[#547A85] leading-relaxed">
        I am always interested in discussing new engineering projects, full-stack architecture roles, internship opportunities, or interesting system problems.
      </p>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-4">
      <Button href="/contact" variant="primary" size="lg">
        Get in Touch
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </Button>
      <Button
        href={`mailto:${siteConfig.social.email}`}
        variant="outline"
        size="lg"
        aria-label={`Send direct email to ${siteConfig.social.email}`}
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        {siteConfig.social.email}
      </Button>
    </div>

    <div class="pt-6 border-t border-[#D8EAEF] max-w-md mx-auto flex items-center justify-center gap-6 text-sm text-[#547A85]">
      <a
        href={siteConfig.social.github}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-[#006D77] font-medium transition-colors inline-flex items-center gap-1.5"
      >
        <span>GitHub</span> &rarr;
      </a>
      <span class="text-[#D8EAEF]">•</span>
      <a
        href={siteConfig.social.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-[#006D77] font-medium transition-colors inline-flex items-center gap-1.5"
      >
        <span>LinkedIn</span> &rarr;
      </a>
      <span class="text-[#D8EAEF]">•</span>
      <a
        href="/work"
        class="hover:text-[#006D77] font-medium transition-colors inline-flex items-center gap-1.5"
      >
        <span>Case Studies</span> &rarr;
      </a>
    </div>
  </div>
</section>
