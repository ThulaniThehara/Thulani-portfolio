---
import Button from '../ui/Button.astro';
import { siteConfig } from '../../data/siteConfig';
---

<section class="py-16 sm:py-24 max-w-6xl mx-auto px-4 sm:px-6 reveal-on-scroll">
  <div class="text-center max-w-xl mx-auto space-y-5">
    <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#1F2937]">
      Let's work together
    </h2>
    <p class="text-base text-[#718096] leading-relaxed">
      I'm open to full-stack engineering roles, cloud architecture projects, and hardware/software collaborations.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
      <Button href="/contact" variant="primary" size="lg" class="group">
        Get in Touch
        <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform duration-150" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </Button>
      <Button href={`mailto:${siteConfig.social.email}`} variant="outline" size="lg">
        {siteConfig.social.email}
      </Button>
    </div>
  </div>
</section>
