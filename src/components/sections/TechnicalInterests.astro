---
interface SkillCard {
  id: string;
  category: string;
  subtitle: string;
  number: string;
  icon: string;
  color: string;
  accentColor: string;
  technologies: { name: string; tag: string; isHighlight?: boolean }[];
}

const cards: SkillCard[] = [
  {
    id: 'frontend',
    category: 'Frontend',
    subtitle: 'Client interfaces & reactive web apps',
    number: '01',
    icon: '💻',
    color: '#006D77',
    accentColor: '#83C5BE',
    technologies: [
      { name: 'React', tag: 'Core', isHighlight: true },
      { name: 'TypeScript', tag: 'Core', isHighlight: true },
      { name: 'Astro', tag: 'Framework' },
      { name: 'Next.js', tag: 'Full-Stack' },
      { name: 'Tailwind CSS', tag: 'Styling' },
      { name: 'Vite', tag: 'Build' },
      { name: 'HTML', tag: 'Structure' },
      { name: 'CSS', tag: 'Design' },
    ],
  },
  {
    id: 'backend',
    category: 'Backend',
    subtitle: 'Server logic, APIs & data pipelines',
    number: '02',
    icon: '⚡',
    color: '#006D77',
    accentColor: '#83C5BE',
    technologies: [
      { name: 'Node.js', tag: 'Runtime', isHighlight: true },
      { name: 'Express', tag: 'Framework', isHighlight: true },
      { name: 'FastAPI', tag: 'Python' },
      { name: 'MongoDB', tag: 'Database' },
      { name: 'GraphQL', tag: 'Query' },
      { name: 'REST APIs', tag: 'Protocol' },
    ],
  },
  {
    id: 'cloud',
    category: 'Cloud',
    subtitle: 'Serverless architecture & message queues',
    number: '03',
    icon: '☁️',
    color: '#006D77',
    accentColor: '#83C5BE',
    technologies: [
      { name: 'AWS', tag: 'Cloud Platform', isHighlight: true },
      { name: 'Lambda', tag: 'Serverless', isHighlight: true },
      { name: 'AppSync (Subscription)', tag: 'GraphQL' },
      { name: 'DynamoDB', tag: 'NoSQL' },
      { name: 'SQS', tag: 'Queues' },
      { name: 'Cognito', tag: 'Auth' },
    ],
  },
  {
    id: 'tools',
    category: 'Tools and Database',
    subtitle: 'Development workflows & containers',
    number: '04',
    icon: '🛠️',
    color: '#006D77',
    accentColor: '#83C5BE',
    technologies: [
      { name: 'Git', tag: 'VCS', isHighlight: true },
      { name: 'GitHub', tag: 'Collaboration', isHighlight: true },
      { name: 'VS Code', tag: 'Editor' },
      { name: 'Figma', tag: 'Design' },
      { name: 'Vitest', tag: 'Testing' },
      { name: 'Docker', tag: 'Containers' },
      { name: 'Kubernetes', tag: 'Orchestration' },
    ],
  },
  {
    id: 'iot',
    category: 'IoT & Hardware',
    subtitle: 'Microcontrollers & sensor electronics',
    number: '05',
    icon: '🔌',
    color: '#006D77',
    accentColor: '#83C5BE',
    technologies: [
      { name: 'ESP32', tag: 'Microcontroller', isHighlight: true },
      { name: 'Arduino', tag: 'Platform', isHighlight: true },
      { name: 'FSR', tag: 'Force Sensor' },
      { name: 'BPW34', tag: 'Photodiode' },
      { name: 'Embedded Systems', tag: 'Firmware' },
    ],
  },
];
---

<section class="py-20 sm:py-28 bg-[var(--bg-page)] relative overflow-hidden border-y border-[var(--border-subtle)] reveal-on-scroll" id="skills-section">
  <!-- Calm Background Texture: Subtle minimal dots in soft teal at low opacity -->
  <div class="absolute inset-0 pointer-events-none opacity-25 bg-[radial-gradient(#83C5BE_1px,transparent_1px)] [background-size:24px_24px]"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
    <!-- Section Introduction -->
    <div class="text-center max-w-2xl mx-auto space-y-3 mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#EDF6F9] border border-[#83C5BE]/60 text-[#006D77] text-xs font-semibold uppercase tracking-wider shadow-2xs">
        <span class="w-1.5 h-1.5 rounded-full bg-[#E29578] animate-pulse"></span>
        <span>SKILLS & TECHNOLOGIES</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#006D77]">
        Technologies I Build With
      </h2>
      <p class="text-base text-[var(--text-muted)]">
        Tools I use to turn ideas into working systems.
      </p>
    </div>

    <!-- 3D Circular Path Carousel Container -->
    <div class="relative w-full max-w-4xl mx-auto min-h-[460px] sm:min-h-[500px] flex items-center justify-center select-none" id="carousel-stage">
      <!-- Cards Wrapper with 3D Perspective -->
      <div class="relative w-full h-[430px] sm:h-[450px] flex items-center justify-center [perspective:1200px]" id="carousel-track">
        {cards.map((card, index) => (
          <div
            class="carousel-card absolute w-[300px] sm:w-[360px] md:w-[390px] bg-white rounded-3xl border border-[#83C5BE]/60 p-6 sm:p-7 shadow-card transition-all duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] cursor-pointer will-change-transform"
            data-index={index}
            data-card-id={card.id}
          >
            <!-- Card Header: Primary Deep Teal #006D77 + Secondary Soft Teal #83C5BE -->
            <div class="flex items-start justify-between border-b border-[#D8EAEF] pb-4 mb-5">
              <div class="flex items-center gap-3">
                <span class="w-12 h-12 rounded-2xl bg-[#EDF6F9] border border-[#83C5BE]/60 flex items-center justify-center text-2xl shadow-2xs">
                  {card.icon}
                </span>
                <div>
                  <h3 class="text-xl font-extrabold text-[#006D77] tracking-tight leading-tight">
                    {card.category}
                  </h3>
                  <p class="text-xs text-[#547A85] mt-0.5 font-medium">
                    {card.subtitle}
                  </p>
                </div>
              </div>

              <!-- Category Number Badge -->
              <span class="px-2.5 py-1 rounded-full text-xs font-mono font-bold bg-[#EDF6F9] border border-[#83C5BE]/50 text-[#006D77]">
                {card.number}
              </span>
            </div>

            <!-- Emphasized Technology Badges with High Contrast #006D77, #83C5BE, #EDF6F9, #FFDDD2 -->
            <div class="flex flex-wrap gap-2.5 pt-1">
              {card.technologies.map((tech) => (
                <div
                  class={`inline-flex items-center gap-2 px-3.5 py-2 rounded-2xl border transition-all duration-200 hover:scale-102 hover:shadow-2xs ${
                    tech.isHighlight
                      ? 'bg-[#EDF6F9] border-[#83C5BE] shadow-2xs'
                      : 'bg-[#EDF6F9]/80 border-[#B6D7DE] hover:bg-white hover:border-[#83C5BE]'
                  }`}
                >
                  <!-- Marker Dot (#006D77 or #83C5BE) -->
                  <span
                    class={`w-2 h-2 rounded-full flex-shrink-0 ${
                      tech.isHighlight ? 'bg-[#006D77]' : 'bg-[#83C5BE]'
                    }`}
                  ></span>

                  <!-- Main Technology Name: Bold Deep Teal #006D77 for maximum focus -->
                  <span class="text-[13px] sm:text-sm font-bold text-[#006D77] tracking-tight">
                    {tech.name}
                  </span>

                  <!-- Divider and Secondary Label / Skill Type: #83C5BE border + muted teal text -->
                  {tech.tag && (
                    <span class="text-[11px] font-medium text-[#547A85] border-l border-[#83C5BE]/70 pl-2 ml-0.5">
                      {tech.tag}
                    </span>
                  )}
                </div>
              ))}
            </div>

            <!-- Card Footer Status: #006D77 text with #E29578 Coral Active Focus Indicator -->
            <div class="mt-6 pt-4 border-t border-[#D8EAEF] flex items-center justify-between text-xs">
              <span class="font-mono text-xs font-bold text-[#006D77]">
                {card.technologies.length} Technologies
              </span>
              <span class="active-badge hidden items-center gap-1.5 font-bold text-[#E29578] text-xs">
                <span class="w-2 h-2 rounded-full bg-[#E29578] animate-pulse"></span>
                Active Focus
              </span>
            </div>
          </div>
        ))}
      </div>

      <!-- Navigation Arrows -->
      <button
        type="button"
        id="carousel-prev"
        class="absolute left-0 sm:-left-5 z-40 w-11 h-11 rounded-full bg-white border border-[#83C5BE] text-[#006D77] shadow-md hover:bg-[#EDF6F9] hover:scale-110 active:scale-95 transition-all flex items-center justify-center cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#006D77]"
        aria-label="Previous Category Card"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
        </svg>
      </button>

      <button
        type="button"
        id="carousel-next"
        class="absolute right-0 sm:-right-5 z-40 w-11 h-11 rounded-full bg-white border border-[#83C5BE] text-[#006D77] shadow-md hover:bg-[#EDF6F9] hover:scale-110 active:scale-95 transition-all flex items-center justify-center cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#006D77]"
        aria-label="Next Category Card"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
        </svg>
      </button>
    </div>

    <!-- Indicator Dots & Category Selector Pills -->
    <div class="flex flex-col items-center gap-4 mt-8">
      <!-- 5 Interactive Navigation Dots with #006D77 and #83C5BE -->
      <div class="flex items-center gap-2.5" role="tablist" aria-label="Skills Category Switcher">
        {cards.map((card, idx) => (
          <button
            type="button"
            class="carousel-dot w-2.5 h-2.5 rounded-full transition-all duration-300 cursor-pointer bg-[#B6D7DE] hover:bg-[#83C5BE]"
            data-dot-index={idx}
            aria-label={`Jump to ${card.category}`}
          ></button>
        ))}
      </div>

      <!-- Quick Category Name Badges -->
      <div class="flex flex-wrap justify-center gap-2 pt-1">
        {cards.map((card, idx) => (
          <button
            type="button"
            class="carousel-nav-pill px-3.5 py-1.5 rounded-full text-xs font-bold border transition-all duration-300 cursor-pointer bg-white border-[#83C5BE]/60 text-[#006D77] hover:border-[#006D77] hover:bg-[#EDF6F9]"
            data-nav-index={idx}
          >
            <span class="mr-1">{card.icon}</span>
            <span>{card.category}</span>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  function setupCircularSkillsCarousel() {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.carousel-card'));
    const dots = Array.from(document.querySelectorAll<HTMLElement>('.carousel-dot'));
    const pills = Array.from(document.querySelectorAll<HTMLElement>('.carousel-nav-pill'));
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');
    const stage = document.getElementById('carousel-stage');

    if (!cards.length) return;

    const total = cards.length; // 5 cards
    let currentIndex = 0; // Starts with Card 0 (Frontend) in the center

    function updateCarousel() {
      const isMobile = window.innerWidth < 640;
      const isTablet = window.innerWidth >= 640 && window.innerWidth < 1024;

      // Distance parameters for circular path
      const translateXDistance = isMobile ? 140 : isTablet ? 230 : 300;

      cards.forEach((card, i) => {
        // Calculate offset in circular queue modulo 5 (-2, -1, 0, 1, 2)
        let diff = (i - currentIndex) % total;
        if (diff > total / 2) diff -= total;
        if (diff < -total / 2) diff += total;

        const activeBadge = card.querySelector<HTMLElement>('.active-badge');

        if (diff === 0) {
          // Center Card: Emphasized, scaled, straight, full opacity
          card.style.transform = 'translate3d(0, 0, 80px) scale(1) rotateY(0deg) rotateZ(0deg)';
          card.style.opacity = '1';
          card.style.zIndex = '30';
          card.style.pointerEvents = 'auto';
          card.style.cursor = 'default';
          card.classList.add('shadow-card-hover', 'border-[#006D77]', 'ring-1', 'ring-[#006D77]/20');
          card.classList.remove('opacity-60');
          if (activeBadge) activeBadge.style.display = 'inline-flex';
        } else if (diff === -1) {
          // Left Card: Angled outward to left, smaller, lower opacity
          card.style.transform = `translate3d(-${translateXDistance}px, 0, -40px) scale(0.85) rotateY(18deg) rotateZ(-1.5deg)`;
          card.style.opacity = isMobile ? '0.35' : '0.65';
          card.style.zIndex = '20';
          card.style.pointerEvents = 'auto';
          card.style.cursor = 'pointer';
          card.classList.remove('shadow-card-hover', 'border-[#006D77]', 'ring-1', 'ring-[#006D77]/20');
          if (activeBadge) activeBadge.style.display = 'none';
        } else if (diff === 1) {
          // Right Card: Angled outward to right, smaller, lower opacity
          card.style.transform = `translate3d(${translateXDistance}px, 0, -40px) scale(0.85) rotateY(-18deg) rotateZ(1.5deg)`;
          card.style.opacity = isMobile ? '0.35' : '0.65';
          card.style.zIndex = '20';
          card.style.pointerEvents = 'auto';
          card.style.cursor = 'pointer';
          card.classList.remove('shadow-card-hover', 'border-[#006D77]', 'ring-1', 'ring-[#006D77]/20');
          if (activeBadge) activeBadge.style.display = 'none';
        } else if (diff === -2) {
          // Far Left Card: Stacked behind along circular path
          card.style.transform = `translate3d(-${translateXDistance * 1.5}px, 0, -120px) scale(0.7) rotateY(28deg)`;
          card.style.opacity = '0';
          card.style.zIndex = '10';
          card.style.pointerEvents = 'none';
          if (activeBadge) activeBadge.style.display = 'none';
        } else {
          // Far Right Card: Stacked behind along circular path
          card.style.transform = `translate3d(${translateXDistance * 1.5}px, 0, -120px) scale(0.7) rotateY(-28deg)`;
          card.style.opacity = '0';
          card.style.zIndex = '10';
          card.style.pointerEvents = 'none';
          if (activeBadge) activeBadge.style.display = 'none';
        }
      });

      // Update Navigation Dots
      dots.forEach((dot, idx) => {
        if (idx === currentIndex) {
          dot.classList.add('w-8', 'bg-[#006D77]');
          dot.classList.remove('w-2.5', 'bg-[#B6D7DE]');
        } else {
          dot.classList.remove('w-8', 'bg-[#006D77]');
          dot.classList.add('w-2.5', 'bg-[#B6D7DE]');
        }
      });

      // Update Navigation Category Pills
      pills.forEach((pill, idx) => {
        if (idx === currentIndex) {
          pill.classList.add('bg-[#006D77]', 'text-white', 'border-[#006D77]', 'shadow-xs');
          pill.classList.remove('bg-white', 'text-[#006D77]', 'border-[#83C5BE]/60');
        } else {
          pill.classList.remove('bg-[#006D77]', 'text-white', 'border-[#006D77]', 'shadow-xs');
          pill.classList.add('bg-white', 'text-[#006D77]', 'border-[#83C5BE]/60');
        }
      });
    }

    function goToIndex(newIndex: number) {
      currentIndex = (newIndex + total) % total;
      updateCarousel();
    }

    function next() {
      goToIndex(currentIndex + 1);
    }

    function prev() {
      goToIndex(currentIndex - 1);
    }

    // Direct Card Click: clicking on left card moves it to middle; right card moves to middle
    cards.forEach((card, index) => {
      card.addEventListener('click', () => {
        let diff = (index - currentIndex) % total;
        if (diff > total / 2) diff -= total;
        if (diff < -total / 2) diff += total;

        if (diff !== 0) {
          goToIndex(index);
        }
      });
    });

    // Arrow Button Handlers
    nextBtn?.addEventListener('click', next);
    prevBtn?.addEventListener('click', prev);

    // Indicator Dot Handlers
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const targetIndex = parseInt(dot.getAttribute('data-dot-index') || '0', 10);
        goToIndex(targetIndex);
      });
    });

    // Nav Pill Handlers
    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const targetIndex = parseInt(pill.getAttribute('data-nav-index') || '0', 10);
        goToIndex(targetIndex);
      });
    });

    // Keyboard Navigation
    function handleKeyDown(e: KeyboardEvent) {
      if (e.key === 'ArrowLeft') {
        prev();
      } else if (e.key === 'ArrowRight') {
        next();
      }
    }
    window.addEventListener('keydown', handleKeyDown);

    // Touch Swipe Support for Mobile
    let touchStartX = 0;
    let touchEndX = 0;

    stage?.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    stage?.addEventListener('touchend', (e: TouchEvent) => {
      touchEndX = e.changedTouches[0].screenX;
      const swipeDistance = touchEndX - touchStartX;
      if (Math.abs(swipeDistance) > 40) {
        if (swipeDistance > 0) {
          prev();
        } else {
          next();
        }
      }
    }, { passive: true });

    // Handle Window Resize for responsive distance adjustments
    window.addEventListener('resize', updateCarousel);

    // Initial render
    updateCarousel();
  }

  setupCircularSkillsCarousel();
  document.addEventListener('astro:after-swap', setupCircularSkillsCarousel);
</script>
