---
const skillGroups = [
  {
    category: 'Frontend',
    skills: ['TypeScript', 'React', 'Astro', 'Next.js', 'Tailwind CSS'],
    color: '#006D77',
  },
  {
    category: 'Backend',
    skills: ['Node.js', 'Express', 'Python', 'GraphQL', 'REST APIs'],
    color: '#006D77',
  },
  {
    category: 'Cloud',
    skills: ['AWS Lambda', 'DynamoDB', 'Cloudflare Workers', 'Docker'],
    color: '#00565F',
  },
  {
    category: 'AI',
    skills: ['OpenAI API', 'LangChain', 'RAG', 'Vector Embeddings'],
    color: '#83C5BE',
  },
  {
    category: 'IoT & Hardware',
    skills: ['ESP32', 'C/C++', 'MQTT', 'FreeRTOS', 'Sensors'],
    color: '#E29578',
  },
  {
    category: 'Tools',
    skills: ['Git', 'Vitest', 'PostgreSQL', 'Prisma', 'Linux'],
    color: '#547A85',
  },
];
---

<section class="py-16 sm:py-24 bg-white border-y border-[#D8EAEF] reveal-on-scroll">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="max-w-2xl mb-10 space-y-2">
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#102A30]">
        Skills & Technologies
      </h2>
      <p class="text-base text-[#547A85]">
        Languages, frameworks, and tools I work with regularly.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {skillGroups.map((group) => (
        <div class="space-y-3">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full" style={`background-color: ${group.color}`}></span>
            <h3 class="text-sm font-bold text-[#102A30]">{group.category}</h3>
          </div>
          <div class="flex flex-wrap gap-2">
            {group.skills.map((skill) => (
              <span class="px-2.5 py-1 text-xs font-medium bg-[#EDF6F9] text-[#2D5560] rounded-lg border border-[#D8EAEF]">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
