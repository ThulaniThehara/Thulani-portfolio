---
import { formatDate } from '../../utils/formatters';
import { getUrl } from '../../utils/url';

interface Props {
  title: string;
  description: string;
  category: string;
  tags?: string[];
  publishDate: Date | string;
  readingTime: number;
  externalUrl: string;
  coverImage?: string;
}

const { title, description, category, tags = [], publishDate, readingTime, externalUrl, coverImage } = Astro.props;

const resolvedCoverImage = coverImage ? getUrl(coverImage) : undefined;
const hueShift = title.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0) % 40;
const monogram = title.trim().charAt(0).toUpperCase();
const patternId = `dots-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-').slice(0, 32)}`;
---

<a
  href={externalUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="article-card group relative flex flex-col h-full rounded-3xl bg-white border border-[var(--border-subtle)] overflow-hidden transition-all duration-300 ease-out hover:-translate-y-1.5 hover:border-[var(--brand-soft-teal)] hover:shadow-[0_22px_44px_-18px_rgba(0,109,119,0.35)]"
>
  <!-- Cover Media -->
  <div class="relative h-40 shrink-0 overflow-hidden">
    {resolvedCoverImage ? (
      <img
        src={resolvedCoverImage}
        alt=""
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.06]"
      />
    ) : (
      <div
        class="w-full h-full flex items-center justify-center transition-transform duration-500 ease-out group-hover:scale-[1.06]"
        style={`background: linear-gradient(135deg, hsl(${184 + hueShift} 55% 34%) 0%, hsl(${172 + hueShift} 38% 62%) 100%);`}
      >
        <!-- Decorative dot grid -->
        <svg class="absolute inset-0 w-full h-full opacity-25" aria-hidden="true">
          <defs>
            <pattern id={patternId} width="18" height="18" patternUnits="userSpaceOnUse">
              <circle cx="2" cy="2" r="1.5" fill="white" />
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill={`url(#${patternId})`} />
        </svg>
        <span class="relative text-6xl font-extrabold text-white/25 select-none tracking-tight">
          {monogram}
        </span>
      </div>
    )}

    <!-- Category pill floating over the cover -->
    <span class="absolute top-3 left-3 px-2.5 py-1 rounded-lg bg-white/90 backdrop-blur-sm text-[11px] font-mono font-bold text-[var(--brand-deep-teal)] shadow-sm">
      {category}
    </span>
  </div>

  <!-- Body -->
  <div class="flex flex-col flex-1 p-5 gap-3">
    <h3 class="text-lg font-extrabold text-[var(--text-primary)] leading-snug tracking-tight line-clamp-2 group-hover:text-[var(--brand-deep-teal)] transition-colors">
      {title}
    </h3>

    <p class="text-sm text-[var(--text-muted)] leading-relaxed line-clamp-2">
      {description}
    </p>

    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {tags.slice(0, 3).map((tag) => (
          <span class="px-2 py-0.5 text-[11px] font-medium bg-[var(--bg-surface-subtle)] text-[var(--text-secondary)] rounded-md border border-[var(--border-subtle)]">
            {tag}
          </span>
        ))}
      </div>
    )}

    <!-- Meta + CTA -->
    <div class="flex items-center justify-between gap-3 mt-auto pt-4 border-t border-[var(--border-subtle)]">
      <div class="flex items-center gap-3 text-[11px] text-[var(--text-muted)]">
        <span class="inline-flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
          </svg>
          {formatDate(publishDate)}
        </span>
        <span class="inline-flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          {readingTime} min read
        </span>
      </div>

      <span class="inline-flex items-center gap-1 text-xs font-bold text-[var(--brand-deep-teal)] shrink-0">
        Read Article
        <svg class="w-3.5 h-3.5 transform transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
        </svg>
      </span>
    </div>
  </div>
</a>

<style>
  /* Accent bar that sweeps in along the top edge on hover */
  .article-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--brand-deep-teal), var(--brand-soft-teal), var(--brand-coral));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 2;
  }

  .article-card:hover::before {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .article-card,
    .article-card::before,
    .article-card img,
    .article-card svg {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
