---
import { getUrl } from '../../utils/url';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'accent' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  target?: string;
  rel?: string;
  'aria-label'?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  type = 'button',
  target,
  rel,
  'aria-label': ariaLabel,
} = Astro.props;

const resolvedHref = href ? getUrl(href) : undefined;

const baseStyles = 'inline-flex items-center justify-center font-medium rounded-xl transition-all duration-200 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--brand-deep-teal)]';

const sizeStyles = {
  sm: 'px-3.5 py-1.5 text-xs gap-1.5',
  md: 'px-5 py-2.5 text-sm gap-2',
  lg: 'px-6 py-3.5 text-base gap-2.5',
};

const variantStyles = {
  primary: 'bg-[var(--brand-deep-teal)] text-white hover:bg-[var(--brand-deep-teal-hover)] shadow-xs hover:shadow-sm active:scale-[0.99]',
  secondary: 'bg-[var(--bg-surface-teal-subtle)] text-[var(--brand-deep-teal)] hover:bg-[var(--brand-soft-teal-light)] active:scale-[0.99]',
  accent: 'bg-[var(--brand-coral)] text-white hover:bg-[var(--brand-coral-hover)] shadow-[var(--shadow-coral)] active:scale-[0.99]',
  outline: 'border border-[var(--brand-deep-teal)] text-[var(--brand-deep-teal)] hover:bg-[var(--bg-surface-teal-subtle)] active:scale-[0.99]',
  ghost: 'text-[var(--brand-deep-teal)] hover:bg-[var(--bg-surface-teal-subtle)] active:scale-[0.99]',
};

const computedClass = `${baseStyles} ${sizeStyles[size]} ${variantStyles[variant]} ${className}`;
---

{
  resolvedHref ? (
    <a
      href={resolvedHref}
      class={computedClass}
      target={target}
      rel={target === '_blank' ? (rel || 'noopener noreferrer') : rel}
      aria-label={ariaLabel}
    >
      <slot />
    </a>
  ) : (
    <button
      type={type}
      class={computedClass}
      aria-label={ariaLabel}
    >
      <slot />
    </button>
  )
}
