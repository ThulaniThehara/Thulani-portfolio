---
interface Props {
  size?: 'sm' | 'md' | 'lg' | 'full';
  class?: string;
  as?: string;
}

const {
  size = 'lg',
  class: className = '',
  as: Element = 'div',
} = Astro.props;

const sizeStyles = {
  sm: 'max-w-3xl',
  md: 'max-w-5xl',
  lg: 'max-w-6xl',
  full: 'max-w-7xl',
};
---

<Element class={`w-full mx-auto px-4 sm:px-6 lg:px-8 ${sizeStyles[size]} ${className}`}>
  <slot />
</Element>
