---
interface Props {
  variant?: 'default' | 'subtle' | 'peach' | 'interactive' | 'bordered';
  padding?: 'none' | 'sm' | 'md' | 'lg';
  class?: string;
  as?: string;
}

const {
  variant = 'default',
  padding = 'md',
  class: className = '',
  as: Element = 'div',
} = Astro.props;

const paddingStyles = {
  none: '',
  sm: 'p-4',
  md: 'p-6',
  lg: 'p-8 sm:p-10',
};

const variantStyles = {
  default: 'bg-[var(--bg-surface)] border border-[var(--border-subtle)] shadow-[var(--shadow-card)]',
  subtle: 'bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]',
  peach: 'bg-[var(--brand-soft-peach)]/30 border border-[var(--border-peach)]',
  interactive: 'bg-[var(--bg-surface)] border border-[var(--border-subtle)] shadow-[var(--shadow-card)] hover:border-[var(--brand-soft-teal)] hover:shadow-[var(--shadow-card-hover)] transition-all duration-200',
  bordered: 'bg-transparent border border-[var(--border-subtle)]',
};
---

<Element class={`rounded-2xl ${paddingStyles[padding]} ${variantStyles[variant]} ${className}`}>
  <slot />
</Element>
