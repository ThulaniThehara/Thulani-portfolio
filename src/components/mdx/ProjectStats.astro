---
interface StatItem {
  label: string;
  value: string;
  detail?: string;
}

interface Props {
  stats: StatItem[];
}

const { stats = [] } = Astro.props;
---

<div class="my-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
  {stats.map((item) => (
    <div class="p-4 rounded-xl bg-white border border-[var(--border-subtle)] space-y-1 shadow-2xs">
      <div class="text-2xl sm:text-3xl font-extrabold text-[var(--brand-deep-teal)] tracking-tight">
        {item.value}
      </div>
      <div class="text-xs font-bold text-[var(--text-primary)]">
        {item.label}
      </div>
      {item.detail && (
        <div class="text-[11px] text-[var(--text-muted)] leading-tight">
          {item.detail}
        </div>
      )}
    </div>
  ))}
</div>
