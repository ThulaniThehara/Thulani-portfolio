---
interface Props {
  src?: string;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="my-8 rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] overflow-hidden shadow-xs">
  {src ? (
    <img src={src} alt={alt} class="w-full h-auto object-cover max-h-[480px]" loading="lazy" />
  ) : (
    <div class="h-64 bg-gradient-to-br from-[var(--bg-surface-teal-subtle)] via-[var(--bg-page)] to-white flex flex-col items-center justify-center p-6 text-center border-b border-[var(--border-subtle)]">
      <div class="w-12 h-12 rounded-xl bg-[var(--brand-deep-teal)]/10 text-[var(--brand-deep-teal)] flex items-center justify-center mb-2">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
      <span class="text-sm font-semibold text-[var(--text-primary)]">{alt}</span>
      <span class="text-xs text-[var(--text-muted)] mt-1">[Visual Architecture Artifact Placeholder]</span>
    </div>
  )}
  {caption && (
    <figcaption class="p-3 text-center text-xs text-[var(--text-muted)] bg-[var(--bg-surface-subtle)] border-t border-[var(--border-subtle)]">
      {caption}
    </figcaption>
  )}
</figure>
