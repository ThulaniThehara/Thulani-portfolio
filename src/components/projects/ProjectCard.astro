---
import { formatDate } from '../../utils/formatters';

interface Props {
  id: string;
  title: string;
  description: string;
  category: string;
  projectType?: string;
  icon?: string;
  frontendTech?: string[];
  backendTech?: string[];
  databaseTech?: string[];
  githubUrl?: string;
  tags?: string[];
  publishDate?: Date | string;
}

const { id, title, description, category, projectType, icon, frontendTech = [], backendTech = [], databaseTech = [], githubUrl, tags, publishDate } = Astro.props;

// SVG icons mapping based on the `icon` string
const getIcon = (name?: string) => {
  if (name === 'cloud' || name === 'serverless') {
    return `<svg class="w-8 h-8 text-[var(--brand-deep-teal)]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" /></svg>`;
  }
  // Default icon (code)
  return `<svg class="w-8 h-8 text-[var(--brand-deep-teal)]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>`;
}
---

<div class="group perspective-1000 relative w-full h-[450px]">
  <!-- Inner Container for 3D Transform -->
  <div class="project-card-inner relative w-full h-full transition-transform duration-700 preserve-3d">
    
    <!-- Front Face -->
    <article class="absolute inset-0 backface-hidden bg-white rounded-2xl border border-[var(--border-subtle)] flex flex-col justify-between p-6 shadow-sm hover:shadow-md transition-shadow">
      
      <!-- Top Section -->
      <div>
        <div class="text-[10px] font-bold tracking-widest text-[var(--text-muted)] uppercase mb-4">
          {projectType || category}
        </div>
        <div class="mb-4 bg-[var(--bg-surface-teal-subtle)] w-14 h-14 flex items-center justify-center rounded-xl">
          <Fragment set:html={getIcon(icon)} />
        </div>
        <h3 class="text-2xl font-extrabold text-[var(--brand-deep-teal)] leading-tight mb-6">
          {title}
        </h3>
        
        <!-- Tech Stacks -->
        <div class="space-y-4">
          {frontendTech.length > 0 && (
            <div class="flex items-start gap-3 text-sm">
              <span class="font-semibold text-[var(--text-secondary)] min-w-[70px]">Frontend:</span>
              <span class="text-[var(--text-primary)]">{frontendTech.join(', ')}</span>
            </div>
          )}
          {backendTech.length > 0 && (
            <div class="flex items-start gap-3 text-sm">
              <span class="font-semibold text-[var(--text-secondary)] min-w-[70px]">Backend:</span>
              <span class="text-[var(--text-primary)]">{backendTech.join(', ')}</span>
            </div>
          )}
          {databaseTech.length > 0 && (
            <div class="flex items-start gap-3 text-sm">
              <span class="font-semibold text-[var(--text-secondary)] min-w-[70px]">Database:</span>
              <span class="text-[var(--text-primary)]">{databaseTech.join(', ')}</span>
            </div>
          )}
        </div>
      </div>

      <!-- Bottom Section (Buttons) -->
      <div class="flex items-center justify-between border-t border-[var(--border-subtle)] pt-4 mt-auto">
        <button class="flip-btn-front flex items-center gap-1.5 text-xs font-bold text-[var(--brand-deep-teal)] hover:text-[var(--brand-soft-teal)] transition-colors focus:outline-none">
          See Description
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </button>
        {githubUrl && (
          <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="px-4 py-2 bg-[var(--brand-deep-teal)] text-white text-xs font-bold rounded-full hover:bg-[var(--brand-soft-teal)] transition-colors focus:outline-none">
            Source Code
          </a>
        )}
      </div>
    </article>

    <!-- Back Face -->
    <article class="absolute inset-0 backface-hidden rotate-y-180 bg-[var(--brand-deep-teal)] text-white rounded-2xl border border-[var(--brand-deep-teal)] flex flex-col p-6 shadow-lg">
      <div class="flex-1 overflow-y-auto custom-scrollbar pr-2 space-y-4">
        <h4 class="text-xl font-bold text-white mb-2">{title}</h4>
        <p class="text-white/90 text-sm leading-relaxed">
          {description}
        </p>
        <div class="pt-4 mt-4 border-t border-white/10">
           <a href={`/work/${id}`} class="inline-flex items-center gap-2 text-sm font-bold text-[var(--brand-soft-teal)] hover:text-white transition-colors">
            Read Full Case Study
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
           </a>
        </div>
      </div>
      
      <!-- Back Bottom Section -->
      <div class="pt-4 mt-auto">
        <button class="flip-btn-back flex items-center gap-1.5 text-xs font-bold text-white/80 hover:text-white transition-colors focus:outline-none">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Overview
        </button>
      </div>
    </article>

  </div>
</div>

<script>
  function initProjectCards() {
    const frontButtons = document.querySelectorAll('.flip-btn-front');
    const backButtons = document.querySelectorAll('.flip-btn-back');

    frontButtons.forEach(btn => {
      // Remove old listeners by cloning, just to be safe if init runs multiple times
      const newBtn = btn.cloneNode(true);
      btn.parentNode?.replaceChild(newBtn, btn);
      newBtn.addEventListener('click', (e) => {
        const cardInner = (e.currentTarget as HTMLElement).closest('.project-card-inner');
        if (cardInner) {
          cardInner.classList.add('rotate-y-180');
        }
      });
    });

    backButtons.forEach(btn => {
      const newBtn = btn.cloneNode(true);
      btn.parentNode?.replaceChild(newBtn, btn);
      newBtn.addEventListener('click', (e) => {
        const cardInner = (e.currentTarget as HTMLElement).closest('.project-card-inner');
        if (cardInner) {
          cardInner.classList.remove('rotate-y-180');
        }
      });
    });
  }

  // Run on initial load and view transitions
  document.addEventListener('DOMContentLoaded', initProjectCards);
  document.addEventListener('astro:page-load', initProjectCards);
</script>

<style>
  .perspective-1000 {
    perspective: 1000px;
  }
  .preserve-3d {
    transform-style: preserve-3d;
  }
  .backface-hidden {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .rotate-y-180 {
    transform: rotateY(180deg);
  }
  
  /* Custom thin scrollbar for back description if it gets too long */
  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.4);
  }
</style>
