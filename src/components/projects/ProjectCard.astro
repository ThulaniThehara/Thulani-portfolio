---
import { formatDate } from '../../utils/formatters';
import Badge from '../ui/Badge.astro';

interface Props {
  id: string;
  title: string;
  description: string;
  category: string;
  tags: string[];
  publishDate: Date | string;
}

const { id, title, description, category, tags, publishDate } = Astro.props;

// Category-based badge/accent configuration matching design system
const getCategoryDetails = (cat: string) => {
  if (cat.toLowerCase().includes('iot') || cat.toLowerCase().includes('hardware')) {
    return {
      badgeVariant: 'peach' as const,
      gradient: 'from-[var(--brand-coral)]/15 via-[var(--brand-soft-peach)]/20 to-[var(--bg-surface)]',
      icon: 'IoT',
    };
  }
  if (cat.toLowerCase().includes('ai') || cat.toLowerCase().includes('intelligence')) {
    return {
      badgeVariant: 'soft-teal' as const,
      gradient: 'from-[var(--brand-deep-teal)]/15 via-[var(--brand-soft-teal)]/20 to-[var(--bg-surface)]',
      icon: 'AI',
    };
  }
  return {
    badgeVariant: 'subtle' as const,
    gradient: 'from-[var(--brand-deep-teal)]/10 via-[var(--bg-page)] to-[var(--bg-surface)]',
    icon: 'SYS',
  };
};

const categoryInfo = getCategoryDetails(category);
---

<article class="group relative flex flex-col justify-between bg-[var(--bg-surface)] rounded-2xl border border-[var(--border-subtle)] overflow-hidden hover:border-[var(--brand-soft-teal)] hover:shadow-[var(--shadow-card-hover)] transition-all duration-200">
  <!-- Card Visual Header -->
  <div class={`h-36 w-full bg-gradient-to-br ${categoryInfo.gradient} border-b border-[var(--border-subtle)] p-5 flex flex-col justify-between relative overflow-hidden`}>
    <div class="flex items-center justify-between z-10">
      <Badge variant={categoryInfo.badgeVariant} size="md">
        {category}
      </Badge>
      <span class="font-mono text-xs font-bold text-[var(--text-muted)] bg-white/80 backdrop-blur-xs px-2 py-0.5 rounded-md border border-[var(--border-subtle)]">
        {categoryInfo.icon}
      </span>
    </div>

    <!-- Subtle abstract architectural lines -->
    <div class="absolute right-0 bottom-0 opacity-15 pointer-events-none transform translate-x-2 translate-y-2">
      <svg width="120" height="120" viewBox="0 0 120 120" fill="none" stroke="var(--brand-deep-teal)" stroke-width="1.5">
        <rect x="10" y="10" width="100" height="100" rx="10" />
        <line x1="10" y1="60" x2="110" y2="60" />
        <line x1="60" y1="10" x2="60" y2="110" />
        <circle cx="60" cy="60" r="16" fill="var(--brand-soft-teal)" />
      </svg>
    </div>

    <div class="z-10">
      <time class="text-xs text-[var(--text-muted)] font-medium block">
        {formatDate(publishDate)}
      </time>
    </div>
  </div>

  <!-- Card Body Content -->
  <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
    <div class="space-y-2">
      <h3 class="text-xl font-bold text-[var(--text-primary)] group-hover:text-[var(--brand-deep-teal)] transition-colors leading-snug">
        <a href={`/work/${id}`} class="focus:outline-none focus:underline after:absolute after:inset-0">
          {title}
        </a>
      </h3>
      <p class="text-sm text-[var(--text-muted)] leading-relaxed line-clamp-3">
        {description}
      </p>
    </div>

    <!-- Technology Badges & Link Indicator -->
    <div class="space-y-4 pt-2">
      <div class="flex flex-wrap gap-1.5 z-10 relative">
        {tags.slice(0, 4).map((tag) => (
          <Badge variant="subtle" size="sm">
            {tag}
          </Badge>
        ))}
      </div>

      <div class="pt-3 border-t border-[var(--border-subtle)] flex items-center justify-between text-xs font-semibold text-[var(--brand-deep-teal)] group-hover:text-[var(--brand-deep-teal-hover)]">
        <span>Read Case Study</span>
        <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </div>
    </div>
  </div>
</article>
