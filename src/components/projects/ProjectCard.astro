---
import { formatDate } from '../../utils/formatters';

interface Props {
  id: string;
  title: string;
  description: string;
  category: string;
  tags: string[];
  publishDate: Date | string;
  accentGradient?: string;
}

const { id, title, description, category, tags, publishDate } = Astro.props;

// Category-based badge/accent configuration
const getCategoryDetails = (cat: string) => {
  if (cat.toLowerCase().includes('iot') || cat.toLowerCase().includes('hardware')) {
    return {
      badgeClass: 'bg-[#FFDDD2] text-[#b86243] border-[#E29578]/40',
      gradient: 'from-[#E29578]/15 via-[#FFDDD2]/20 to-white',
      icon: 'IoT',
    };
  }
  if (cat.toLowerCase().includes('ai') || cat.toLowerCase().includes('intelligence')) {
    return {
      badgeClass: 'bg-[#83C5BE]/30 text-[#006D77] border-[#83C5BE]',
      gradient: 'from-[#006D77]/15 via-[#83C5BE]/20 to-white',
      icon: 'AI',
    };
  }
  return {
    badgeClass: 'bg-[#EDF6F9] text-[#006D77] border-[#D8EAEF]',
    gradient: 'from-[#006D77]/10 via-[#EDF6F9] to-white',
    icon: 'SYS',
  };
};

const categoryInfo = getCategoryDetails(category);
---

<article class="group relative flex flex-col justify-between bg-white rounded-2xl border border-[#D8EAEF] overflow-hidden hover:border-[#83C5BE] hover:shadow-md transition-all duration-200">
  <!-- Card Visual Header -->
  <div class={`h-36 w-full bg-gradient-to-br ${categoryInfo.gradient} border-b border-[#D8EAEF] p-5 flex flex-col justify-between relative overflow-hidden`}>
    <div class="flex items-center justify-between z-10">
      <span class={`inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold border ${categoryInfo.badgeClass}`}>
        {category}
      </span>
      <span class="font-mono text-xs font-bold text-[#547A85] bg-white/80 backdrop-blur-xs px-2 py-0.5 rounded-md border border-[#D8EAEF]">
        {categoryInfo.icon}
      </span>
    </div>

    <!-- Subtle abstract architectural lines -->
    <div class="absolute right-0 bottom-0 opacity-15 pointer-events-none transform translate-x-2 translate-y-2">
      <svg width="120" height="120" viewBox="0 0 120 120" fill="none" stroke="#006D77" stroke-width="1.5">
        <rect x="10" y="10" width="100" height="100" rx="10" />
        <line x1="10" y1="60" x2="110" y2="60" />
        <line x1="60" y1="10" x2="60" y2="110" />
        <circle cx="60" cy="60" r="16" fill="#83C5BE" />
      </svg>
    </div>

    <div class="z-10">
      <time class="text-xs text-[#547A85] font-medium block">
        {formatDate(publishDate)}
      </time>
    </div>
  </div>

  <!-- Card Body Content -->
  <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
    <div class="space-y-2">
      <h3 class="text-xl font-bold text-[#102A30] group-hover:text-[#006D77] transition-colors leading-snug">
        <a href={`/work/${id}`} class="focus:outline-none focus:underline after:absolute after:inset-0">
          {title}
        </a>
      </h3>
      <p class="text-sm text-[#547A85] leading-relaxed line-clamp-3">
        {description}
      </p>
    </div>

    <!-- Technology Badges & Link Indicator -->
    <div class="space-y-4 pt-2">
      <div class="flex flex-wrap gap-1.5 z-10 relative">
        {tags.slice(0, 4).map((tag) => (
          <span class="text-[11px] font-medium bg-[#EDF6F9] text-[#2D5560] px-2 py-0.5 rounded-md border border-[#D8EAEF]">
            {tag}
          </span>
        ))}
      </div>

      <div class="pt-3 border-t border-[#D8EAEF] flex items-center justify-between text-xs font-semibold text-[#006D77] group-hover:text-[#00565f]">
        <span>Read Case Study</span>
        <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </div>
    </div>
  </div>
</article>
