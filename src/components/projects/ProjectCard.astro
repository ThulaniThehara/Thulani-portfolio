---
import { formatDate } from '../../utils/formatters';
import Badge from '../ui/Badge.astro';

interface Props {
  id: string;
  title: string;
  description: string;
  category: string;
  tags: string[];
  publishDate: Date | string;
}

const { id, title, description, category, tags, publishDate } = Astro.props;
---

<article class="group relative flex flex-col justify-between bg-white rounded-2xl border border-[var(--border-subtle)] overflow-hidden hover:border-[var(--brand-soft-teal)] hover:shadow-md transition-all duration-200">
  <!-- Category Header -->
  <div class="px-5 pt-5 pb-3 flex items-center justify-between">
    <Badge variant="soft-teal" size="sm">
      {category}
    </Badge>
    <time class="text-xs text-[var(--text-muted)] font-mono">
      {formatDate(publishDate)}
    </time>
  </div>

  <!-- Content -->
  <div class="px-5 pb-5 flex-1 flex flex-col justify-between space-y-3">
    <div class="space-y-2">
      <h3 class="text-lg font-bold text-[var(--text-primary)] group-hover:text-[var(--brand-deep-teal)] transition-colors leading-snug">
        <a href={`/work/${id}`} class="focus:outline-none focus:underline after:absolute after:inset-0">
          {title}
        </a>
      </h3>
      <p class="text-sm text-[var(--text-muted)] leading-relaxed line-clamp-2">
        {description}
      </p>
    </div>

    <!-- Tech Tags -->
    <div class="flex flex-wrap gap-1.5 pt-2">
      {tags.slice(0, 4).map((tag) => (
        <span class="text-[11px] font-medium bg-[var(--bg-page)] text-[var(--text-secondary)] px-2 py-0.5 rounded-md border border-[var(--border-subtle)]">
          {tag}
        </span>
      ))}
    </div>

    <!-- Link -->
    <div class="pt-3 border-t border-[var(--border-subtle)] flex items-center justify-between text-xs font-semibold text-[var(--brand-deep-teal)]">
      <span>Read Case Study</span>
      <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
      </svg>
    </div>
  </div>
</article>
