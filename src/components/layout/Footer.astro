---
import { siteConfig } from '../../data/siteConfig';
import { navItems } from '../../data/navigation';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[#D8EAEF] bg-white/80 mt-auto">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
      <!-- Column 1: Brand & Bio -->
      <div class="md:col-span-2 space-y-3">
        <a href="/" class="text-xl font-bold tracking-tight text-[#102A30] flex items-center gap-2">
          <span class="w-7 h-7 rounded-md bg-[#006D77] text-white flex items-center justify-center font-mono text-xs font-semibold">
            T
          </span>
          <span>{siteConfig.author}</span>
        </a>
        <p class="text-sm text-[#547A85] max-w-md leading-relaxed">
          {siteConfig.positioning}
        </p>
        <div class="flex items-center gap-3 pt-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-[#83C5BE]/20 text-[#006D77]">
            <span class="w-1.5 h-1.5 rounded-full bg-[#006D77] animate-pulse"></span>
            Available for opportunities
          </span>
        </div>
      </div>

      <!-- Column 2: Quick Links -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-[#102A30]">Navigation</h3>
        <ul class="space-y-2 text-sm text-[#547A85]">
          {navItems.map((item) => (
            <li>
              <a href={item.href} class="hover:text-[#006D77] transition-colors">
                {item.label}
              </a>
            </li>
          ))}
          <li>
            <a href="/lab" class="hover:text-[#006D77] transition-colors">
              Lab
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Connect & Socials -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-[#102A30]">Connect</h3>
        <ul class="space-y-2 text-sm text-[#547A85]">
          <li>
            <a
              href={siteConfig.social.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 hover:text-[#006D77] transition-colors"
              aria-label="GitHub Profile"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
              GitHub
            </a>
          </li>
          <li>
            <a
              href={siteConfig.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 hover:text-[#006D77] transition-colors"
              aria-label="LinkedIn Profile"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
              </svg>
              LinkedIn
            </a>
          </li>
          <li>
            <a
              href={siteConfig.social.medium}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 hover:text-[#006D77] transition-colors"
              aria-label="Medium Profile"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42c1.87 0 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z" />
              </svg>
              Medium
            </a>
          </li>
          <li>
            <a
              href={`mailto:${siteConfig.social.email}`}
              class="inline-flex items-center gap-2 hover:text-[#006D77] transition-colors"
              aria-label="Send Email"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              {siteConfig.social.email}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="pt-6 border-t border-[#D8EAEF] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#7E9FA8]">
      <p>&copy; {currentYear} {siteConfig.author}. Built with Astro & TypeScript.</p>
    </div>
  </div>
</footer>
