---
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import type { LabExperiment } from '../../data/labExperiments';

interface Props {
  experiment: LabExperiment;
}

const { experiment } = Astro.props;

// Status Badge Variant & Visual Indicators
const getStatusBadge = (status: LabExperiment['status']) => {
  switch (status) {
    case 'Completed':
      return { variant: 'soft-teal' as const, dotClass: 'bg-[var(--brand-deep-teal)]', label: 'Completed' };
    case 'In Progress':
      return { variant: 'teal' as const, dotClass: 'bg-white animate-pulse', label: 'In Progress' };
    case 'Prototype':
      return { variant: 'peach' as const, dotClass: 'bg-[var(--text-coral)] animate-ping', label: 'Prototype' };
    case 'Experiment':
      return { variant: 'subtle' as const, dotClass: 'bg-[var(--brand-soft-teal)]', label: 'Experiment' };
  }
};

const statusInfo = getStatusBadge(experiment.status);
---

<article
  class="group relative flex flex-col justify-between bg-[var(--bg-surface)] rounded-2xl border border-[var(--border-subtle)] hover:border-[var(--brand-soft-teal)] hover:shadow-[var(--shadow-card-hover)] transition-all duration-200 p-6 space-y-6"
  data-category={experiment.category}
  data-status={experiment.status}
>
  <!-- Card Top: Category, Date & Status -->
  <div class="space-y-3">
    <div class="flex items-center justify-between gap-2 border-b border-[var(--border-subtle)] pb-3">
      <div class="flex items-center gap-2">
        <span class="px-2.5 py-0.5 rounded-md bg-[var(--bg-surface-teal-subtle)] text-[var(--brand-deep-teal)] text-xs font-mono font-bold">
          {experiment.category}
        </span>
        <span class="text-xs font-mono text-[var(--text-muted)]">{experiment.date}</span>
      </div>

      <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[var(--bg-page)] border border-[var(--border-subtle)] text-[11px] font-semibold text-[var(--text-secondary)]">
        <span class={`w-1.5 h-1.5 rounded-full ${statusInfo.dotClass}`}></span>
        <span>{statusInfo.label}</span>
      </div>
    </div>

    <!-- Title & Description -->
    <div class="space-y-2">
      <h3 class="text-xl font-bold text-[var(--text-primary)] group-hover:text-[var(--brand-deep-teal)] transition-colors leading-snug">
        {experiment.title}
      </h3>
      <p class="text-sm text-[var(--text-muted)] leading-relaxed">
        {experiment.description}
      </p>
    </div>

    <!-- Key Technical Highlights -->
    {experiment.highlights && experiment.highlights.length > 0 && (
      <ul class="space-y-1.5 pt-2 text-xs text-[var(--text-secondary)]">
        {experiment.highlights.map((item) => (
          <li class="flex items-start gap-2">
            <span class="text-[var(--brand-deep-teal)] font-bold text-xs mt-0.5">›</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    )}
  </div>

  <!-- Card Bottom: Tech Stack, Metrics & Action Links -->
  <div class="space-y-4 pt-4 border-t border-[var(--border-subtle)]">
    <!-- Metrics Bar (if available) -->
    {experiment.metrics && experiment.metrics.length > 0 && (
      <div class="grid grid-cols-2 gap-2 bg-[var(--bg-page)] p-2.5 rounded-xl border border-[var(--border-subtle)] text-center">
        {experiment.metrics.map((m) => (
          <div>
            <div class="text-xs font-mono font-extrabold text-[var(--brand-deep-teal)]">{m.value}</div>
            <div class="text-[10px] text-[var(--text-muted)] uppercase tracking-wider">{m.label}</div>
          </div>
        ))}
      </div>
    )}

    <!-- Technology Tags -->
    <div class="flex flex-wrap gap-1.5">
      {experiment.technologies.map((tech) => (
        <span class="px-2 py-0.5 text-[11px] font-medium bg-[var(--bg-page)] text-[var(--text-secondary)] rounded-md border border-[var(--border-subtle)]">
          {tech}
        </span>
      ))}
    </div>

    <!-- Action Links -->
    <div class="flex items-center justify-between pt-2">
      {experiment.githubUrl ? (
        <a
          href={experiment.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--brand-deep-teal)] hover:text-[var(--brand-deep-teal-hover)] transition-colors"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          <span>View Source & Experiments</span>
        </a>
      ) : <div />}

      {experiment.demoUrl && (
        <a
          href={experiment.demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-xs font-semibold text-[var(--brand-coral)] hover:underline"
        >
          Live Sandbox &rarr;
        </a>
      )}
    </div>
  </div>
</article>
