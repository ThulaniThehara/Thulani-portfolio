---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../utils/formatters';
import Button from '../components/ui/Button.astro';

interface Props {
  title: string;
  description: string;
  publishDate: Date | string;
  category: string;
  tags?: string[];
  githubUrl?: string;
  liveUrl?: string;
}

const {
  title,
  description,
  publishDate,
  category,
  tags = [],
  githubUrl,
  liveUrl,
} = Astro.props;
---

<BaseLayout title={`${title} | Case Study`} description={description}>
  <article class="max-w-3xl mx-auto py-12 px-4 sm:px-6">
    <div class="mb-6">
      <a href="/work" class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#006D77] hover:underline">
        &larr; Back to all projects
      </a>
    </div>

    <header class="mb-12 space-y-4">
      <div class="flex items-center gap-3 text-xs text-[#547A85]">
        <span class="font-semibold px-2.5 py-1 rounded-md bg-[#83C5BE]/20 text-[#006D77]">{category}</span>
        <span>•</span>
        <time>{formatDate(publishDate)}</time>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-[#102A30] leading-tight">{title}</h1>
      <p class="text-lg text-[#547A85] leading-relaxed">{description}</p>
      
      <div class="flex flex-wrap gap-2 pt-2">
        {tags.map((tag) => (
          <span class="text-xs bg-[#EDF6F9] border border-[#D8EAEF] px-2.5 py-1 rounded-md text-[#2D5560] font-medium">
            {tag}
          </span>
        ))}
      </div>

      {(githubUrl || liveUrl) && (
        <div class="flex items-center gap-4 pt-4 border-t border-[#D8EAEF]">
          {githubUrl && (
            <Button href={githubUrl} variant="outline" size="sm" target="_blank" rel="noopener noreferrer">
              GitHub Repository &rarr;
            </Button>
          )}
          {liveUrl && (
            <Button href={liveUrl} variant="primary" size="sm" target="_blank" rel="noopener noreferrer">
              Live Demo &rarr;
            </Button>
          )}
        </div>
      )}
    </header>

    <div class="bg-white rounded-2xl border border-[#D8EAEF] p-6 sm:p-8 text-[#2D5560] leading-relaxed">
      <slot />
    </div>
  </article>
</BaseLayout>
