---
import BaseLayout from './BaseLayout.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  prev?: CollectionEntry<'projects'> | null;
  next?: CollectionEntry<'projects'> | null;
}

const { project, prev, next } = Astro.props;
const { data } = project;

const technologies = Array.from(new Set([...(data.technologies || []), ...(data.tags || [])]));
---

<BaseLayout title={`${data.title} | Case Study`} description={data.description}>
  <article class="max-w-4xl mx-auto py-10 px-4 sm:px-6">
    <!-- Breadcrumb & Back Link -->
    <div class="flex items-center justify-between gap-4 mb-8">
      <a
        href="/work"
        class="inline-flex items-center gap-2 text-xs font-semibold text-[var(--brand-deep-teal)] hover:text-[var(--brand-deep-teal-hover)] transition-colors py-1 px-2.5 rounded-lg bg-[var(--bg-surface-teal-subtle)]"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
        Back to all projects
      </a>
      <div class="text-xs text-[var(--text-muted)] font-mono hidden sm:block">
        Case Study // {data.year}
      </div>
    </div>

    <!-- Case Study Hero Header -->
    <header class="space-y-6 mb-12">
      <div class="flex flex-wrap items-center gap-2">
        <Badge variant="teal" size="md">
          {data.category}
        </Badge>
        <Badge variant="soft-teal" size="md">
          {data.year}
        </Badge>
        {data.status && (
          <Badge variant={data.status === 'Completed' ? 'subtle' : 'peach'} size="md" dot>
            {data.status}
          </Badge>
        )}
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-[var(--text-primary)] leading-[1.15]">
        {data.title}
      </h1>

      <p class="text-lg sm:text-xl text-[var(--text-muted)] leading-relaxed font-normal">
        {data.description}
      </p>

      <!-- Action Buttons -->
      {(data.liveUrl || data.githubUrl) && (
        <div class="flex flex-wrap items-center gap-3 pt-2">
          {data.liveUrl && (
            <Button href={data.liveUrl} variant="primary" size="md" target="_blank" rel="noopener noreferrer">
              Launch Live Demo
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
              </svg>
            </Button>
          )}
          {data.githubUrl && (
            <Button href={data.githubUrl} variant="outline" size="md" target="_blank" rel="noopener noreferrer">
              GitHub Repository
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
            </Button>
          )}
        </div>
      )}

      <!-- Metadata Box -->
      <div class="rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] p-6 shadow-xs grid grid-cols-2 sm:grid-cols-4 gap-6">
        <div>
          <span class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-muted)] block mb-1">My Role</span>
          <span class="text-sm font-bold text-[var(--text-primary)]">{data.role || 'Software Engineer'}</span>
        </div>
        <div>
          <span class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-muted)] block mb-1">Duration</span>
          <span class="text-sm font-bold text-[var(--text-primary)]">{data.duration || '3 Months'}</span>
        </div>
        <div>
          <span class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-muted)] block mb-1">Team</span>
          <span class="text-sm font-bold text-[var(--text-primary)]">{data.team || 'Individual'}</span>
        </div>
        <div>
          <span class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-muted)] block mb-1">Year</span>
          <span class="text-sm font-bold text-[var(--text-primary)]">{data.year}</span>
        </div>
      </div>

      <!-- Tech Stack Badges -->
      {technologies.length > 0 && (
        <div class="space-y-2">
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-[var(--brand-deep-teal)]">
            Primary Stack:
          </span>
          <div class="flex flex-wrap gap-1.5">
            {technologies.map((tech) => (
              <Badge variant="subtle" size="sm">
                {tech}
              </Badge>
            ))}
          </div>
        </div>
      )}
    </header>

    <!-- Main Case Study MDX Content Container -->
    <div class="bg-[var(--bg-surface)] rounded-3xl border border-[var(--border-subtle)] p-6 sm:p-10 lg:p-12 shadow-xs leading-relaxed text-[var(--text-secondary)] space-y-6">
      <slot />
    </div>

    <!-- Next / Prev Project Navigation Cards -->
    {(prev || next) && (
      <div class="mt-12 pt-8 border-t border-[var(--border-subtle)] grid grid-cols-1 sm:grid-cols-2 gap-4">
        {prev ? (
          <a
            href={`/work/${prev.id}`}
            class="p-5 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] hover:border-[var(--brand-soft-teal)] hover:shadow-xs transition-all space-y-1 block text-left group"
          >
            <span class="text-xs font-mono text-[var(--text-muted)] flex items-center gap-1 group-hover:text-[var(--brand-deep-teal)]">
              &larr; Previous Case Study
            </span>
            <div class="text-base font-bold text-[var(--text-primary)] group-hover:text-[var(--brand-deep-teal)]">
              {prev.data.title}
            </div>
            <span class="text-xs text-[var(--text-muted)]">{prev.data.category}</span>
          </a>
        ) : <div />}

        {next ? (
          <a
            href={`/work/${next.id}`}
            class="p-5 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] hover:border-[var(--brand-soft-teal)] hover:shadow-xs transition-all space-y-1 block text-right group"
          >
            <span class="text-xs font-mono text-[var(--text-muted)] flex items-center justify-end gap-1 group-hover:text-[var(--brand-deep-teal)]">
              Next Case Study &rarr;
            </span>
            <div class="text-base font-bold text-[var(--text-primary)] group-hover:text-[var(--brand-deep-teal)]">
              {next.data.title}
            </div>
            <span class="text-xs text-[var(--text-muted)]">{next.data.category}</span>
          </a>
        ) : <div />}
      </div>
    )}

    <!-- Bottom Case Study CTA -->
    <div class="mt-12 text-center p-8 rounded-2xl bg-gradient-to-b from-[var(--bg-surface)] to-[var(--bg-page)] border border-[var(--border-subtle)] space-y-4">
      <h3 class="text-xl font-bold text-[var(--text-primary)]">
        Interested in building a system like this?
      </h3>
      <p class="text-sm text-[var(--text-muted)] max-w-md mx-auto">
        I am available for full-stack engineering roles, systems consulting, and IoT hardware collaborations.
      </p>
      <div class="pt-2 flex justify-center gap-4">
        <Button href="/contact" variant="primary" size="md">
          Start a Conversation
        </Button>
        <Button href="/work" variant="outline" size="md">
          Explore More Work
        </Button>
      </div>
    </div>
  </article>
</BaseLayout>
