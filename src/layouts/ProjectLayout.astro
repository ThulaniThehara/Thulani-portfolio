---
import BaseLayout from './BaseLayout.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import type { CollectionEntry } from 'astro:content';
import { getUrl } from '../utils/url';

interface Props {
  project: CollectionEntry<'projects'>;
  prev?: CollectionEntry<'projects'> | null;
  next?: CollectionEntry<'projects'> | null;
}

const { project, prev, next } = Astro.props;
const { data } = project;

const technologies = Array.from(new Set([...(data.technologies || []), ...(data.tags || [])]));

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://thulani.dev';
const canonicalURL = new URL(Astro.url.pathname, siteUrl).toString();

// Case Study Specific JSON-LD Schema
const projectStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: data.title,
  description: data.description,
  url: canonicalURL,
  author: {
    '@type': 'Person',
    name: 'Thulani',
    jobTitle: 'Software Engineer',
  },
  datePublished: data.publishDate ? new Date(data.publishDate).toISOString() : `${data.year}-01-01T00:00:00Z`,
  about: {
    '@type': 'SoftwareApplication',
    name: data.title,
    applicationCategory: data.category,
    operatingSystem: 'Cross-Platform',
    softwareRequirements: technologies.join(', '),
  },
  keywords: technologies.join(', '),
};
---

<BaseLayout
  title={`${data.title} — Engineering Case Study | Thulani`}
  description={data.description}
  type="article"
  publishDate={data.publishDate}
  structuredData={projectStructuredData}
>
  <article class="max-w-4xl mx-auto py-10 px-4 sm:px-6">
    <!-- Breadcrumb & Back Link -->
    <div class="flex items-center justify-between gap-4 mb-8 animate-fade-in-up">
      <a
        href={getUrl('/work')}
        class="inline-flex items-center gap-2 text-xs font-semibold text-[var(--brand-deep-teal)] hover:text-[var(--brand-deep-teal-hover)] transition-colors py-1 px-2.5 rounded-lg bg-[var(--bg-surface-teal-subtle)] hover:bg-[var(--brand-soft-teal-light)] group"
      >
        <svg class="w-3.5 h-3.5 transform group-hover:-translate-x-0.5 transition-transform duration-150" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
        Back to all projects
      </a>
      <div class="text-xs text-[var(--text-muted)] font-mono hidden sm:block">
      </div>
    </div>

    <!-- Case Study Hero Header with Staggered Entrance -->
    <header class="space-y-6 mb-12">
      <div class="flex flex-wrap items-center gap-2 animate-fade-in-up delay-100">
        <Badge variant="teal" size="md">
          {data.category}
        </Badge>
        <Badge variant="soft-teal" size="md">
          {data.year}
        </Badge>
        {data.status && (
          <Badge variant={data.status === 'Completed' ? 'subtle' : 'peach'} size="md" dot>
            {data.status}
          </Badge>
        )}
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-[var(--text-primary)] leading-[1.15] animate-fade-in-up delay-150">
        {data.title}
      </h1>



      <!-- Action Buttons -->
      {(data.liveUrl || data.githubUrl || data.githubUrlFrontend || data.githubUrlBackend) && (
        <div class="flex flex-wrap items-center gap-3 pt-2 animate-fade-in-up delay-250">
          {data.liveUrl && (
            <Button href={data.liveUrl} variant="primary" size="md" target="_blank" rel="noopener noreferrer" class="group">
              Launch Live Demo
              <svg class="w-4 h-4 transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform duration-150" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
              </svg>
            </Button>
          )}
          {data.githubUrlFrontend && (
            <Button href={data.githubUrlFrontend} variant="outline" size="md" target="_blank" rel="noopener noreferrer">
              Frontend Repository
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
            </Button>
          )}
          {data.githubUrlBackend && (
            <Button href={data.githubUrlBackend} variant="outline" size="md" target="_blank" rel="noopener noreferrer">
              Backend Repository
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
            </Button>
          )}
          {data.githubUrl && !data.githubUrlFrontend && !data.githubUrlBackend && (
            <Button href={data.githubUrl} variant="outline" size="md" target="_blank" rel="noopener noreferrer">
              GitHub Repository
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
            </Button>
          )}
        </div>
      )}

      <!-- Metadata Cards Row -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 animate-fade-in-up delay-300">
        <!-- Duration Card -->
        <div class="p-5 rounded-2xl bg-white border border-[var(--border-subtle)] shadow-2xs hover:border-[var(--brand-soft-teal)] hover:shadow-xs transition-all duration-200 flex items-center gap-4">
          <div class="w-10 h-10 rounded-xl bg-[var(--bg-surface-teal-subtle)] text-[var(--brand-deep-teal)] flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-[var(--text-muted)] block">Duration</span>
            <span class="text-base font-extrabold text-[var(--text-primary)]">{data.duration || '3 Months'}</span>
          </div>
        </div>

        <!-- Team Card -->
        <div class="p-5 rounded-2xl bg-white border border-[var(--border-subtle)] shadow-2xs hover:border-[var(--brand-soft-teal)] hover:shadow-xs transition-all duration-200 flex items-center gap-4">
          <div class="w-10 h-10 rounded-xl bg-[#DFF3F8] text-[#017286] flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <div>
            <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-[var(--text-muted)] block">Team</span>
            <span class="text-base font-extrabold text-[var(--text-primary)]">{data.team || 'Personal Project'}</span>
          </div>
        </div>

        <!-- Year Card -->
        <div class="p-5 rounded-2xl bg-white border border-[var(--border-subtle)] shadow-2xs hover:border-[var(--brand-soft-teal)] hover:shadow-xs transition-all duration-200 flex items-center gap-4">
          <div class="w-10 h-10 rounded-xl bg-[var(--bg-surface-teal-subtle)] text-[var(--brand-deep-teal)] flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-[var(--text-muted)] block">Year</span>
            <span class="text-base font-extrabold text-[var(--text-primary)]">{data.year}</span>
          </div>
        </div>
      </div>


    </header>

    <!-- Main Case Study MDX Content Container -->
    <div class="bg-[var(--bg-surface)] rounded-3xl border border-[var(--border-subtle)] p-6 sm:p-10 lg:p-12 shadow-xs leading-relaxed text-[var(--text-secondary)] space-y-6">
      <slot />
    </div>

    <!-- Next / Prev Project Navigation Cards -->
    {(prev || next) && (
      <div class="mt-12 pt-8 border-t border-[var(--border-subtle)] grid grid-cols-1 sm:grid-cols-2 gap-4">
        {prev ? (
          <a
            href={getUrl(`/work/${prev.id}`)}
            class="p-5 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] hover:border-[var(--brand-soft-teal)] hover:shadow-xs hover:-translate-y-0.5 transition-all duration-200 space-y-1 block text-left group"
          >
            <span class="text-xs font-mono text-[var(--text-muted)] flex items-center gap-1 group-hover:text-[var(--brand-deep-teal)]">
              <span class="transform group-hover:-translate-x-1 transition-transform duration-150">&larr;</span> Previous Case Study
            </span>
            <div class="text-base font-bold text-[var(--text-primary)] group-hover:text-[var(--brand-deep-teal)] transition-colors">
              {prev.data.title}
            </div>
            <span class="text-xs text-[var(--text-muted)]">{prev.data.category}</span>
          </a>
        ) : <div />}

        {next ? (
          <a
            href={getUrl(`/work/${next.id}`)}
            class="p-5 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] hover:border-[var(--brand-soft-teal)] hover:shadow-xs hover:-translate-y-0.5 transition-all duration-200 space-y-1 block text-right group"
          >
            <span class="text-xs font-mono text-[var(--text-muted)] flex items-center justify-end gap-1 group-hover:text-[var(--brand-deep-teal)]">
              Next Case Study <span class="transform group-hover:translate-x-1 transition-transform duration-150">&rarr;</span>
            </span>
            <div class="text-base font-bold text-[var(--text-primary)] group-hover:text-[var(--brand-deep-teal)] transition-colors">
              {next.data.title}
            </div>
            <span class="text-xs text-[var(--text-muted)]">{next.data.category}</span>
          </a>
        ) : <div />}
      </div>
    )}

    <!-- Bottom Case Study CTA -->
    <div class="mt-12 text-center p-8 rounded-2xl bg-gradient-to-b from-[var(--bg-surface)] to-[var(--bg-page)] border border-[var(--border-subtle)] space-y-4">
      <h3 class="text-xl font-bold text-[var(--text-primary)]">
        Interested in building a system like this?
      </h3>
      <p class="text-sm text-[var(--text-muted)] max-w-md mx-auto">
        I am available for full-stack engineering roles, systems consulting, and IoT hardware collaborations.
      </p>
      <div class="pt-2 flex justify-center gap-4">
        <Button href="/contact" variant="primary" size="md">
          Start a Conversation
        </Button>
        <Button href="/work" variant="outline" size="md">
          Explore More Work
        </Button>
      </div>
    </div>
  </article>
</BaseLayout>
