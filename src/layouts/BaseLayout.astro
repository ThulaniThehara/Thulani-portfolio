---
import '../styles/global.css';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import { siteConfig } from '../data/siteConfig';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  publishDate?: Date | string;
  structuredData?: Record<string, any>;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = '/images/profile/og-image.png',
  type = 'website',
  publishDate,
  structuredData,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://thulani.dev';
const canonicalURL = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(image, siteUrl).toString();

// Default JSON-LD Schema
const defaultStructuredData = structuredData || {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteConfig.author,
  jobTitle: siteConfig.role,
  description: siteConfig.description,
  url: siteUrl,
  sameAs: [
    siteConfig.social.github,
    siteConfig.social.linkedin,
  ],
  knowsAbout: [
    'Software Engineering',
    'Cloud Computing',
    'Serverless Architecture',
    'Artificial Intelligence',
    'Internet of Things (IoT)',
    'Full-Stack Web Development',
  ],
};
---

<!doctype html>
<html lang="en" class="h-full scroll-smooth">
  <head>
    <!-- Essential Meta Tags -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#006D77" />

    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph Protocol (Facebook, LinkedIn, Discord) -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Thulani Portfolio" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={title} />
    {publishDate && <meta property="article:published_time" content={new Date(publishDate).toISOString()} />}

    <!-- Twitter Card Meta -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Icons & Manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Performance Preconnect for Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(defaultStructuredData)} />
  </head>
  <body class="min-h-full flex flex-col bg-[#EDF6F9] text-[#102A30] antialiased selection:bg-[#83C5BE] selection:text-[#004249]">
    <!-- Accessibility Skip Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[#006D77] focus:text-white focus:rounded-lg focus:shadow-lg focus:outline-none"
    >
      Skip to content
    </a>

    <Navbar />
    
    <main id="main-content" class="flex-1 w-full">
      <slot />
    </main>

    <Footer />

    <!-- Performance: Deferred Scroll-Reveal Observer -->
    <script>
      function setupScrollReveal() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.querySelectorAll('.reveal-on-scroll').forEach((el) => {
            el.classList.add('is-revealed');
          });
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
              }
            });
          },
          {
            rootMargin: '0px 0px -30px 0px',
            threshold: 0.05,
          }
        );

        document.querySelectorAll('.reveal-on-scroll:not(.is-revealed)').forEach((el) => {
          observer.observe(el);
        });
      }

      setupScrollReveal();
      document.addEventListener('astro:after-swap', setupScrollReveal);
    </script>
  </body>
</html>
