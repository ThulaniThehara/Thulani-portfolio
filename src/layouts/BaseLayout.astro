---
import '../styles/global.css';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import TealCurrent from '../components/background/TealCurrent.astro';
import { siteConfig } from '../data/siteConfig';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  publishDate?: Date | string;
  structuredData?: Record<string, any>;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = '/images/profile/og-image.png',
  type = 'website',
  publishDate,
  structuredData,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://thulani.dev';
const canonicalURL = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(image, siteUrl).toString();

// Default JSON-LD Schema
const defaultStructuredData = structuredData || {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteConfig.author,
  jobTitle: siteConfig.role,
  description: siteConfig.description,
  url: siteUrl,
  sameAs: [
    siteConfig.social.github,
    siteConfig.social.linkedin,
    siteConfig.social.medium,
  ],
  knowsAbout: [
    'Software Engineering',
    'Cloud Computing',
    'Serverless Architecture',
    'Artificial Intelligence',
    'Internet of Things (IoT)',
    'Full-Stack Web Development',
  ],
};
---

<!doctype html>
<html lang="en" class="h-full scroll-smooth">
  <head>
    <!-- Essential Meta Tags -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#03045A" />

    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph Protocol (Facebook, LinkedIn, Discord) -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Thulani Portfolio" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={title} />
    {publishDate && <meta property="article:published_time" content={new Date(publishDate).toISOString()} />}

    <!-- Twitter Card Meta -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Icons & Manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Performance Preconnect for Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(defaultStructuredData)} />
  </head>
  <body class="min-h-full flex flex-col bg-[#F5F9FB] text-[#1F2937] antialiased selection:bg-[#8FD6E9] selection:text-[#020341] relative">
    <!-- Reusable Global Background Component -->
    <TealCurrent />

    <!-- Accessibility Skip Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[#03045A] focus:text-white focus:rounded-lg focus:shadow-lg focus:outline-none"
    >
      Skip to content
    </a>

    <Navbar />
    
    <main id="main-content" class="flex-1 w-full relative z-10">
      <slot />
    </main>

    <Footer />

    <!-- Scroll-linked "approach" reveal: sections ease toward the viewer as they enter, -->
    <!-- tracked continuously against scroll position (not a one-shot trigger) for a smooth, -->
    <!-- physically-lagging motion. See .reveal-on-scroll / .approach-3d in global.css. -->
    <script>
      function setupScrollReveal() {
        const items = Array.from(document.querySelectorAll<HTMLElement>('.reveal-on-scroll'));
        if (!items.length) return;

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          items.forEach((el) => {
            el.style.opacity = '1';
            el.style.transform = 'none';
          });
          return;
        }

        const clamp01 = (n: number) => Math.min(1, Math.max(0, n));
        const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);

        const current = new Map<HTMLElement, number>(items.map((el) => [el, 0]));
        const activeEls = new Set<HTMLElement>();
        let rafId: number | null = null;

        function computeTarget(el: HTMLElement) {
          const rect = el.getBoundingClientRect();
          const vh = window.innerHeight;
          const raw = 1 - (rect.top - vh * 0.15) / (vh * 0.6);
          return clamp01(raw);
        }

        function apply(el: HTMLElement, value: number) {
          const eased = easeOutCubic(value);
          const translateY = (1 - eased) * 56;
          const scale = 0.94 + eased * 0.06;
          let transform = `translateY(${translateY}px) scale(${scale})`;

          if (el.classList.contains('approach-3d')) {
            const rotateX = (1 - eased) * 8;
            const translateZ = (1 - eased) * -120;
            transform = `translateY(${translateY}px) translateZ(${translateZ}px) rotateX(${rotateX}deg) scale(${scale})`;
          }

          el.style.opacity = String(eased);
          el.style.transform = transform;
        }

        function tick() {
          activeEls.forEach((el) => {
            const target = computeTarget(el);
            const prev = current.get(el) ?? 0;
            const next = prev + (target - prev) * 0.18;
            current.set(el, next);
            apply(el, next);
          });

          rafId = activeEls.size ? requestAnimationFrame(tick) : null;
        }

        function ensureLoop() {
          if (rafId === null) rafId = requestAnimationFrame(tick);
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const el = entry.target as HTMLElement;
              if (entry.isIntersecting) {
                activeEls.add(el);
                ensureLoop();
              } else {
                activeEls.delete(el);
              }
            });
          },
          { rootMargin: '20% 0px 20% 0px', threshold: 0 }
        );

        items.forEach((el) => observer.observe(el));
      }

      setupScrollReveal();
      document.addEventListener('astro:after-swap', setupScrollReveal);
    </script>
  </body>
</html>
